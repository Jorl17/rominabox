/* The picture the author chose for behind the menu. For a game with one, we
 * ship it as background.png beside the document and mark #screen
 * with-background when we compose. A design can restyle
 * #screen.with-background to draw it differently. The path is from parts/. */
#screen.with-background
{
	decorator: image("../background.png" cover);
}

/* It is the background of the menu, never of the game. While the game runs
 * we draw overlays from this document, with `overlay` on the body. */
body.overlay #screen.with-background
{
	decorator: none;
}
