/* The elements that a player can focus with arrow keys, a d-pad or a pointer,
 * in every design. We link this before the design stylesheet, so a design can
 * override a single move with `nav-up: #id` (or `nav-down`, `nav-left`,
 * `nav-right`, `none` to stop there) and choose where a screen starts with
 * the `autofocus` attribute. In RmlUi an arrow moves to the nearest stop in
 * that direction in the laid-out document, and stops at the edges.
 *
 * In the menu we mark the focused stop `.focused`. Style that, not :focus,
 * which also matches every ancestor. */

/* Only what a player uses responds to the pointer: the stops and their parts,
 * and what is only for the pointer or what the player listens to (a volume
 * arrow, a toggle, a switch). A box around or beside them (a row of buttons,
 * a pager, a status line) never catches a press meant for what is under it,
 * and a press on empty space reaches nothing. */
body, body *
{
	pointer-events: none;
}
.volume-arrow, .toggle, .switch
{
	pointer-events: auto;
}

/* The stops. */
.menu-action, .slot, .list-row, .option-entry, .slider, .list-control,
.list-pager-prev, .list-pager-next, .account-input, .control-callout,
.control-group, .control-picker-current, .control-picker-option
{
	tab-index: auto;
	nav: auto;
	pointer-events: auto;
}

/* Pressing the label or picture of a stop is pressing the stop, and focuses
 * it, wherever the design places them. */
.menu-action *, .slot *, .list-row *, .option-entry *, .slider *,
.list-control *, .control-callout *, .control-group *,
.control-picker-current *, .control-picker-option *
{
	focus: none;
	pointer-events: auto;
}

/* Left and Right on a row turn the page of the list and never leave it. */
.list-row
{
	nav-left: none;
	nav-right: none;
}

/* Not stops: what the player cannot use now, what is only for the pointer
 * (the volume arrows), what is only information (the rows of the bindings
 * popup) and the on-screen keyboard, for which we read the pad directly. */
[disabled], .disabled, .volume-arrow, #control-binds .list-row, .text-key
{
	tab-index: none;
}

/* Everything outside an open dialog or controller picker: no stop, and no
 * target for the pointer. */
.nav-outside
{
	focus: none;
}
.nav-outside, .nav-outside *
{
	pointer-events: none;
}
