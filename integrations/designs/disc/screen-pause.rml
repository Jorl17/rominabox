<div id="pause-panel"><!--SAVE-SLOTS-->
<div id="actions"><button class="menu-action" id="resume" autofocus="autofocus">CONTINUE</button><button class="menu-action" id="save">SAVE (BLOCK <span data-fact="chosen-slot">1</span>)</button><button id="load" class="menu-action disabled" disabled="disabled">LOAD (BLOCK <span data-fact="chosen-slot">1</span>)</button><button class="menu-action" id="disc">DISC</button><button class="menu-action" id="controls">CONTROLS</button><button class="menu-action" id="quit">QUIT</button></div>
<div id="status">CHOOSE A BLOCK</div><!--SCREEN-LINKS--></div>