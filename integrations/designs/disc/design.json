{
  "schemaVersion": 1,
  "id": "disc",
  "name": "Disc",
  "description": "The memory-card browser of a late-90s disc console.",
  "documents": {
    "splash": "splash.rml",
    "style": "menu.rcss"
  },
  "fonts": [
    {
      "file": "Silkscreen-Regular.ttf",
      "license": "Silkscreen-OFL.txt",
      "family": "Silkscreen"
    }
  ],
  "metrics": {
    "options": {
      "entryStep": 60
    },
    "scene": {
      "width": 960,
      "height": 380
    },
    "marker": {
      "diameter": 30
    },
    "callout": {
      "width": 188,
      "height": 36,
      "border": 1
    },
    "group": {
      "width": 210,
      "height": 44,
      "gap": 12,
      "bottomMargin": 8
    }
  },
  "list": {
    "pageSize": 5,
    "rowHeight": 48,
    "rowGap": 4
  },
  "binds": {
    "afterMs": 1200,
    "hoverAfterMs": 300,
    "width": 360
  },
  "overlays": [
    {
      "id": "splash",
      "afterMs": 0,
      "holdMs": 400,
      "leaveMs": 180,
      "needs": "splash-logo.png"
    },
    {
      "id": "notice",
      "follows": "splash",
      "afterMs": 400,
      "holdMs": 2800,
      "leaveMs": 280
    }
  ],
  "screens": [
    {
      "id": "pause",
      "panel": "pause-panel",
      "heading": "MEMORY CARD",
      "footer": "ESC  CONTINUE",
      "button": "controls-back"
    },
    {
      "id": "disc",
      "panel": "disc-panel",
      "heading": "DISC",
      "footer": "ESC  BACK",
      "button": "disc",
      "images": "discs"
    },
    {
      "id": "discs",
      "panel": "discs-panel",
      "heading": "DISC",
      "footer": "ESC  BACK",
      "back": "BACK",
      "images": "list",
      "mark": "IN",
      "option": null
    },
    {
      "id": "options",
      "panel": "options-panel",
      "heading": "INDEX",
      "footer": "ESC  BACK",
      "button": "options",
      "label": "INDEX",
      "back": "BACK",
      "place": "options"
    },
    {
      "id": "controls",
      "panel": "controls-panel",
      "heading": "PAD",
      "footer": "ESC  BACK",
      "button": "controls",
      "option": {
        "label": "PAD",
        "default": true
      }
    },
    {
      "id": "shaders",
      "panel": "shaders-panel",
      "heading": "FILTERS",
      "footer": "ESC  BACK",
      "button": "shaders",
      "back": "BACK",
      "option": {
        "label": "FILTERS",
        "default": false
      }
    }
  ],
  "screenOrder": ["pause", "disc", "discs", "options", "controls", "shaders"],
  "tokens": {
    "ink": "#ffffff"
  }
}
