/* ROM-in-a-Box: the screens and layout of Native, drawn more simply. We apply
 * this over the Native stylesheet (design.json "restyle"), so it contains only
 * what looks different. There is no frame and no bevel: every block is one
 * flat colour, with borders in that colour so nothing moves. Every word is in
 * Science Gothic, with larger titles aligned left. Focus is still yellow. */

/* Under the ids of the document, so it has priority over every rule with the
 * pixel font: classes, the achievements screens, and a button under an id. */
#body, #body *, #body #screen * { font-family: "Science Gothic"; font-weight: bold; }
#screen { border-color: design(screen); }
#heading { left: 56dp; width: 840dp; text-align: left; font-size: 34dp; color: design(ink); }
/* The status on the pause screen is on the line of the footer, level with its
 * words and clear of the buttons above. */
#status { top: 563dp; }
/* Science Gothic is wider than the pixel font, so the six buttons of the
 * pause screen fit in their row at full size only with narrower gaps and
 * padding. */
#actions { column-gap: 8dp; }
#actions button { padding: 0 4dp; }

/* Buttons, pager arrows and option entries. */
.menu-action, .list-pager-prev, .list-pager-next { background-color: design(surface); border-color: design(surface); }
.menu-action:hover, .menu-action.focused,
.list-pager-prev:hover, .list-pager-next:hover, .list-pager-prev.focused, .list-pager-next.focused { background-color: design(highlight); color: design(surface); border-color: design(highlight); }
/* Held down, a button, a slot or a row is pushed in, as in Pixel: dark
 * along its top and left, light along its bottom and right. */
.menu-action:active { background-color: design(highlight); color: design(surface); border-top-color: design(background); border-left-color: design(background); border-bottom-color: design(ink); border-right-color: design(ink); }
.menu-action.disabled, .menu-action:disabled, .list-pager-prev.disabled, .list-pager-next.disabled { background-color: design(well-edge); border-color: design(well-edge); }

/* Save slots. */
.slot { border-color: design(surface); }
.slot.focused { border-color: design(highlight); }
.slot:active { border-top-color: design(background); border-left-color: design(background); border-bottom-color: design(ink); border-right-color: design(ink); }
.slot-label { background-color: design(surface); }
.slot-picture { border-color: design(picture); }
.slot.disabled, .slot.disabled:hover { border-color: design(well-edge); }

/* Volume. */
#volume-control { border-color: design(surface); }
#volume-control .slider-track { border-color: design(bevel-dark); }
.slider-thumb { background-color: design(highlight); border-color: design(highlight); }
.slider:hover .slider-thumb { border-color: design(ink); }
.slider.focused .slider-thumb, .slider.focused:hover .slider-thumb { background-color: design(ink); border-color: design(ink); }
.slider.dragging .slider-thumb, .slider:active .slider-thumb { background-color: design(ink); border-color: design(highlight); }

/* Controls. The pixel font has only capitals, but these words are in mixed
 * case in the console data, and here they look like the button labels. */
.control-label, .control-assignment, .control-picker-current, .control-picker-option, .control-picker-label { text-transform: uppercase; }
/* Science Gothic is wider than the pixel font. At these sizes the longest
 * controller name, for PlayStation, still fits in the picker of every
 * console, both closed and in the list, whose rows are indented further. */
.control-picker-current { font-size: 12dp; }
.control-picker-option { font-size: 11dp; }
.control-callout, .control-group, .control-picker-current { border-color: design(surface); }
.control-callout:hover, .control-group:hover, .control-picker-current:hover { border-color: design(ink); }
.control-callout.focused, .control-group.focused, .control-picker-current.focused { border-color: design(highlight); }

/* Lists: shaders, discs, accounts, achievements. */
.list-row { border-color: design(surface); }
.list-row.focused { border-color: design(highlight); }
.list-row:active { border-top-color: design(background); border-left-color: design(background); border-bottom-color: design(ink); border-right-color: design(ink); }
.list-row-icon, .list-row-wait { border-color: design(bevel-dark); }

/* At the size in Native, the word FULLSCREEN on HOTKEYS is wider in this font
 * than the column of the labels. */
.hotkey { border-color: design(surface); }
.hotkey-label { font-size: 20dp; }
.hotkey-chip { background-color: design(picture); border-color: design(picture); }
.hotkey-chip.pad { background-color: design(focus); border-color: design(focus); }
.hotkey-chip:hover, .hotkey-chip.focused { background-color: design(highlight); color: design(surface); border-color: design(highlight); }
