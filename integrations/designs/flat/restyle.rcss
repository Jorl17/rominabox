/* Flat: the screens and layout of Native, drawn more simply. We apply this
 * over the Native stylesheet (design.json "restyle"), so it contains only
 * what looks different. There is no frame and no bevel: every block is one
 * flat colour, with borders in that colour so nothing moves. Every word is in
 * Science Gothic, with larger titles aligned left. Focus is still yellow. */

/* Under the ids of the document, so it has priority over every rule with the
 * pixel font: classes, the achievements screens, and a button under an id. */
#body, #body *, #body #screen * { font-family: "Science Gothic"; font-weight: bold; }
#screen { border-color: design(screen); }
#heading { left: 56dp; width: 840dp; text-align: left; font-size: 34dp; color: design(ink); }

/* Buttons, pager arrows and option entries. */
.menu-action, .list-pager-prev, .list-pager-next { background-color: design(surface); border-color: design(surface); }
.menu-action:hover, .menu-action.focused, .menu-action.capturing,
.list-pager-prev:hover, .list-pager-next:hover, .list-pager-prev.focused, .list-pager-next.focused { background-color: design(highlight); color: design(surface); border-color: design(highlight); }
.menu-action:active { border-color: design(highlight); }
.menu-action.disabled, .menu-action:disabled, .list-pager-prev.disabled, .list-pager-next.disabled { background-color: design(well-edge); border-color: design(well-edge); }

/* Save slots. */
.slot { border-color: design(surface); }
.slot.focused, [data-focus=save] .slot.selected, [data-focus=load] .slot.selected, .slot:active { border-color: design(highlight); }
.slot-label { background-color: design(surface); }
.slot-picture { border-color: design(picture); }
.slot.disabled, .slot.disabled:hover { border-color: design(well-edge); }

/* Volume. */
#volume-control { border-color: design(surface); }
#volume-control .slider-track { border-color: design(bevel-dark); }
.slider-thumb { background-color: design(ink); border-color: design(ink); }
.slider:hover .slider-thumb { border-color: design(ink); }
.slider.focused .slider-thumb, .slider.focused:hover .slider-thumb, .slider.dragging .slider-thumb, .slider:active .slider-thumb { background-color: design(highlight); border-color: design(highlight); }

/* Controls. The pixel font has only capitals, but these words are in mixed
 * case in the console data, and here they look like the button labels. */
.control-label, .control-assignment, .control-picker-current, .control-picker-option, .control-picker-label { text-transform: uppercase; }
.control-callout, .control-group, .control-picker-current { border-color: design(surface); }
.control-callout:hover, .control-group:hover, .control-picker-current:hover { border-color: design(ink); }
.control-callout.focused, .control-group.focused, .control-picker-current.focused { border-color: design(highlight); }

/* Lists: shaders, discs, accounts, achievements. */
.list-row { border-color: design(surface); }
.list-row.focused, .list-row:active { border-color: design(highlight); }
.list-row-icon, .list-row-wait { border-color: design(bevel-dark); }

/* Menu controls. */
.menu-control { border-color: design(surface); }
.menu-control-chip { background-color: design(picture); border-color: design(picture); }
.menu-control-chip.pad { background-color: design(focus); border-color: design(focus); }
.menu-control-chip:hover, .menu-control-chip.focused { background-color: design(highlight); color: design(surface); border-color: design(highlight); }
