<div id="data-panel" class="screen-panel" style="display:none;"><div class="confirm-copy">Keep this game's saves, states and settings in a zip, or bring them back from one.</div><div class="confirm-actions"><button id="data-export" class="menu-action">EXPORT DATA</button><button id="data-import" class="menu-action">IMPORT DATA</button></div><div id="data-status" class="data-status"></div><div id="data-import-dialog" class="data-dialog" style="display:none;"><div class="data-dialog-title">IMPORT DATA</div><div id="data-import-message" class="data-dialog-copy"></div><div class="data-dialog-actions"><button id="data-import-cancel" class="menu-action">KEEP MY DATA</button><button id="data-import-confirm" class="menu-action">IMPORT</button></div></div></div>
