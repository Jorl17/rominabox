{
  "schemaVersion": 1,
  "id": "native",
  "name": "Native",
  "description": "The cartridge-era pixel look the player ships with.",
  "documents": {
    "menu": "menu.rml",
    "splash": "splash.rml",
    "style": "menu.rcss"
  },
  "fonts": [
    {
      "file": "Silkscreen-Regular.ttf",
      "license": "Silkscreen-OFL.txt",
      "family": "Silkscreen"
    },
    {
      "file": "ScienceGothic-Bold.ttf",
      "license": "ScienceGothic-OFL.txt",
      "family": "Science Gothic"
    }
  ],
  "pictures": ["brand-mark.png"],
  "metrics": {
    "scene": {
      "width": 960,
      "height": 380
    },
    "marker": {
      "diameter": 42
    },
    "callout": {
      "width": 196,
      "height": 50,
      "border": 2
    },
    "group": {
      "width": 236,
      "height": 62,
      "border": 2,
      "gap": 16,
      "bottomMargin": 12
    }
  },
  "list": {
    "pageSize": 5,
    "rowHeight": 68,
    "rowGap": 4
  },
  "binds": {
    "afterMs": 1200,
    "hoverAfterMs": 300,
    "width": 320
  },
  "overlays": [
    {
      "id": "splash",
      "afterMs": 0,
      "holdMs": 550,
      "leaveMs": 250,
      "needs": "splash-logo.png"
    },
    {
      "id": "notice",
      "follows": "splash",
      "afterMs": 700,
      "holdMs": 3600,
      "leaveMs": 500
    }
  ],
  "screens": [
    {
      "id": "pause",
      "role": "pause",
      "panel": "pause-panel",
      "heading": "GAME PAUSED",
      "footer": "ESC  CONTINUE",
      "button": "controls-back"
    },
    {
      "id": "options",
      "role": "options",
      "panel": "options-panel",
      "heading": "OPTIONS",
      "footer": "ESC  BACK",
      "button": "options",
      "label": "OPTIONS",
      "back": "BACK",
      "place": "options",
      "pageSize": 4
    },
    {
      "id": "controls",
      "role": "controls",
      "panel": "controls-panel",
      "heading": "CONTROLS",
      "footer": "ESC  BACK",
      "button": "controls",
      "option": {
        "label": "CONTROLS",
        "default": true
      }
    },
    {
      "id": "menu-controls",
      "role": "menu-controls",
      "panel": "menu-controls-panel",
      "heading": "MENU CONTROLS",
      "footer": "ESC  BACK",
      "button": "menu-controls",
      "option": {
        "label": "MENU CONTROLS",
        "default": true
      }
    },
    {
      "id": "shaders",
      "role": "shaders",
      "panel": "shaders-panel",
      "heading": "SHADERS",
      "footer": "ESC  BACK",
      "button": "shaders",
      "back": "BACK",
      "option": {
        "label": "SHADERS",
        "default": false
      }
    },
    {
      "id": "achievements",
      "role": "achievements",
      "panel": "achievements-panel",
      "heading": "ACHIEVEMENTS",
      "footer": "ESC  BACK",
      "button": "achievements",
      "back": "BACK",
      "option": {
        "label": "ACHIEVEMENTS",
        "default": false
      },
      "pageSize": 4,
      "dialogs": ["achievements-confirm", "achievements-startup"]
    },
    {
      "id": "accounts",
      "role": "accounts",
      "panel": "accounts-panel",
      "heading": "QUICK SIGN IN",
      "footer": "ESC  BACK",
      "button": "achievements-quick",
      "back": "BACK",
      "from": "achievements"
    },
    {
      "id": "discs",
      "role": "discs",
      "panel": "discs-panel",
      "heading": "DISC",
      "footer": "ESC  BACK",
      "button": "discs",
      "back": "BACK",
      "option": {
        "label": "DISC",
        "default": true
      }
    }
  ],
  "tokens": {
    "ink": "#ffffff"
  }
}
