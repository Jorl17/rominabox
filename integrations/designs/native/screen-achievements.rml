<div id="PANEL-ID" class="screen-panel" style="display:none;">
  <div class="list account-screen">
    <div class="account-summary"><span id="achievements-account">RETROACHIEVEMENTS</span><span id="achievements-state" class="account-state">OFF</span></div>
    <div id="achievements-signed-out" class="account-empty">
      <div>Sign in to earn achievements.</div>
      <button id="achievements-login" class="menu-action account-action">SIGN IN TO ENABLE</button>
      <button id="achievements-quick" class="menu-action account-action" style="display:none;">QUICK SIGN IN</button>
    </div>
    <div id="achievements-form" class="account-form" style="display:none;">
      <label for="achievement-username">USERNAME</label>
      <input id="achievement-username" type="text" maxlength="95" class="account-input"/>
      <label for="achievement-password">PASSWORD</label>
      <div class="account-password-row"><input id="achievement-password" type="password" class="account-input"/><button id="achievements-password-visibility" class="menu-action account-reveal">SHOW</button></div>
      <div class="account-form-actions"><button id="achievements-submit" class="menu-action">SIGN IN</button><button id="achievements-cancel" class="menu-action">CANCEL</button></div>
      <div class="account-help">Create an account at retroachievements.org</div>
      <div id="achievements-error" class="account-error"></div>
    </div>
    <div id="achievements-catalog" class="account-catalog" style="display:none;"><!--ROWS--><div class="account-none">There are no achievements.</div></div>
  </div>
  <!--ACTIONS--><!--STATUS-->
</div>
<div id="text-keyboard" class="text-keyboard" style="display:none;">
  <div class="text-keyboard-heading">START: DONE &nbsp; B: DELETE &nbsp; L/R: CHANGE KEYS</div>
  <div id="text-keyboard-grid"></div>
</div>
