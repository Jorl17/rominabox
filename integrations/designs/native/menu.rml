<rml><head><title>ROM-in-a-Box</title><link type="text/rcss" href="menu.rcss"/></head><body id="body">
<div id="screen"><div id="splash"><img id="splash-logo"/></div><div id="heading">GAME PAUSED</div><div id="pause-panel"><div id="slots"><button id="slot-1" class="slot empty selected"><div id="slot-label-1" class="slot-label">SLOT 1</div><div class="slot-picture"><div id="slot-image-1" class="slot-image"/></div><div id="slot-state-1" class="slot-state">EMPTY</div></button>
<button id="slot-2" class="slot empty "><div id="slot-label-2" class="slot-label">SLOT 2</div><div class="slot-picture"><div id="slot-image-2" class="slot-image"/></div><div id="slot-state-2" class="slot-state">EMPTY</div></button>
<button id="slot-3" class="slot empty "><div id="slot-label-3" class="slot-label">SLOT 3</div><div class="slot-picture"><div id="slot-image-3" class="slot-image"/></div><div id="slot-state-3" class="slot-state">EMPTY</div></button>
<button id="slot-4" class="slot empty "><div id="slot-label-4" class="slot-label">SLOT 4</div><div class="slot-picture"><div id="slot-image-4" class="slot-image"/></div><div id="slot-state-4" class="slot-state">EMPTY</div></button>
<button id="slot-5" class="slot empty "><div id="slot-label-5" class="slot-label">SLOT 5</div><div class="slot-picture"><div id="slot-image-5" class="slot-image"/></div><div id="slot-state-5" class="slot-state">EMPTY</div></button>
<button id="slot-6" class="slot empty "><div id="slot-label-6" class="slot-label">SLOT 6</div><div class="slot-picture"><div id="slot-image-6" class="slot-image"/></div><div id="slot-state-6" class="slot-state">EMPTY</div></button></div>
<div id="actions"><button class="menu-action" id="resume">CONTINUE</button><button class="menu-action" id="save">SAVE</button><button id="load" class="menu-action disabled" disabled="disabled">LOAD</button><button class="menu-action" id="controls">CONTROLS</button><button class="menu-action" id="quit">QUIT</button></div>
<div id="status">CHOOSE A SLOT</div><!--SCREEN-LINKS--></div><div id="controls-panel" style="display:none;"><!--CONTROLLER-PICKER--><div id="controller-scene"><!--CONTROLS--></div><div id="controls-actions"><button class="menu-action" id="controls-back">BACK</button><button class="menu-action" id="controls-reset">RESET DEFAULTS</button><button class="menu-action" id="controls-cancel" style="display:none;">CANCEL</button></div><div id="controls-status">SELECT A BUTTON</div></div><!--SCREENS--><div id="notice-row" style="display:none;"><div id="notice"><img id="notice-badge"/><div id="notice-words"><div id="notice-kicker">ACHIEVEMENT UNLOCKED</div><div id="notice-title"></div><div id="notice-detail"></div></div></div></div><div id="footer"><span id="footer-hint">ESC CONTINUE</span><span id="version">ROM-IN-A-BOX / PROTOTYPE</span></div></div></body></rml>
