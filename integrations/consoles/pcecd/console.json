{
  "schemaVersion": 1,
  "id": "pcecd",
  "name": "PC Engine CD / TurboGrafx-CD",
  "aliases": [
    "pc engine cd",
    "turbografx-cd",
    "tg-cd"
  ],
  "content": {
    "extensions": [
      "cue",
      "chd",
      "m3u",
      "ccd",
      "toc"
    ],
    "category": "disc",
    "sheets": [
      {
        "extension": "cue",
        "parser": "cue"
      },
      {
        "extension": "m3u",
        "parser": "playlist"
      },
      {
        "extension": "toc",
        "parser": "toc"
      }
    ],
    "companions": [
      {
        "extension": "sbi"
      },
      {
        "when": "ccd",
        "extension": "img",
        "required": true
      },
      {
        "when": "ccd",
        "extension": "sub",
        "required": true
      }
    ]
  },
  "recognition": {},
  "metadata": {
    "catalog": {
      "provider": "redump",
      "name": "NEC - PC Engine CD - TurboGrafx-CD"
    }
  },
  "cores": [
    {
      "component": "beetle_pce_fast"
    }
  ],
  "controllers": {
    "default": "pce",
    "variants": [
      "pce"
    ]
  },
  "support": {
    "macos-arm64": "enabled"
  },
  "presentationOrder": 20,
  "firmware": [
    {
      "id": "pcecd-system-card",
      "acceptedNames": [
        "syscard3.pce"
      ],
      "minimum": 1,
      "help": "Select a Super CD-ROM2 System Card 3 BIOS that you are entitled to use."
    }
  ]
}
