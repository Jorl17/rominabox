{
  "schemaVersion": 1,
  "id": "ps1",
  "name": "PlayStation",
  "aliases": [
    "playstation",
    "psx",
    "ps1"
  ],
  "content": {
    "extensions": [
      "cue",
      "chd",
      "pbp",
      "m3u",
      "ccd",
      "toc"
    ],
    "category": "disc",
    "sheets": [
      {
        "extension": "cue",
        "parser": "cue"
      },
      {
        "extension": "m3u",
        "parser": "playlist"
      },
      {
        "extension": "toc",
        "parser": "toc"
      }
    ],
    "companions": [
      {
        "extension": "sbi"
      },
      {
        "when": "ccd",
        "extension": "img",
        "required": true
      },
      {
        "when": "ccd",
        "extension": "sub"
      }
    ]
  },
  "recognition": {},
  "metadata": {
    "catalog": {
      "provider": "redump",
      "name": "Sony - PlayStation"
    }
  },
  "cores": [
    {
      "component": "pcsx_rearmed"
    }
  ],
  "controllers": {
    "default": "ps1",
    "variants": [
      "ps1",
      "ps1-analog"
    ]
  },
  "support": {
    "macos-arm64": "enabled"
  },
  "presentationOrder": 11,
  "firmware": [
    {
      "id": "ps1-bios",
      "acceptedNames": [
        "scph5500.bin",
        "scph5501.bin",
        "scph5502.bin",
        "scph1001.bin",
        "scph7001.bin",
        "scph101.bin"
      ],
      "minimum": 0,
      "help": "Optional. PlayStation games run without a BIOS using the built-in high-level one. Adding a real BIOS for the game's region, such as scph5501.bin, improves compatibility. Use only a file you are entitled to."
    }
  ]
}
