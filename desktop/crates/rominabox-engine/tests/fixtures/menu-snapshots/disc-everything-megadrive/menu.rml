</div><div id="accounts-pager" class="list-pager" style="display:none;"><button id="accounts-prev" class="menu-action list-pager-prev">&lt;</button><div id="accounts-page-count" class="list-pager-count"></div><button id="accounts-next" class="menu-action list-pager-next">&gt;</button></div></div><div class="list-actions"><button id="accounts-forget" class="menu-action list-control account-forget">FORGET</button>
