<button id="about-1" class="list-row "><div id="about-1-title" class="list-row-title">RetroArch</div><div id="about-1-detail" class="list-row-detail">GPL-3.0-or-later</div><div id="about-1-state" class="list-row-state"></div></button>
</div><div id="about-pager" class="list-pager" style="display:none;"><button id="about-prev" class="menu-action list-pager-prev">&lt;</button><div id="about-page-count" class="list-pager-count"></div><button id="about-next" class="menu-action list-pager-next">&gt;</button></div></div><div class="list-actions" style="margin-top:-312dp;"><button class="menu-action list-back" id="about-back">BACK</button></div><div id="about-status" class="list-status" style="margin-top:-312dp;">WWW.ROMINABOX.APP<br/>LICENCE TEXTS: CONTENTS/RESOURCES/LEGAL/LICENSES</div></div><div id="unlock-row" style="display:none;"><div id="unlock"><img id="unlock-badge"/><div id="unlock-words"><div id="unlock-kicker">ACHIEVEMENT UNLOCKED</div><div id="unlock-title"></div><div id="unlock-detail"></div></div></div></div><div id="footer"><span id="footer-hint">[ESC]  CONTINUE</span><span id="version"><img id="brand-mark" src="brand-mark.png"/> ROM-IN-A-BOX / @VERSION@</span></div></div></body></rml>
