<button id="ntsc-adaptive" class="list-row "><img class="list-row-icon" src="shaders/ntsc-adaptive/icon.png"/><div id="ntsc-adaptive-title" class="list-row-title">NTSC</div><div id="ntsc-adaptive-detail" class="list-row-detail">A TV signal that blends dithering</div><div id="ntsc-adaptive-state" class="list-row-state"></div></button>
<button id="blargg" class="list-row "><img class="list-row-icon" src="shaders/blargg/icon.png"/><div id="blargg-title" class="list-row-title">COMPOSITE</div><div id="blargg-detail" class="list-row-detail">Colour bleed of a composite cable</div><div id="blargg-state" class="list-row-state"></div></button>
<button id="pal-r57shell" class="list-row "><img class="list-row-icon" src="shaders/pal-r57shell/icon.png"/><div id="pal-r57shell-title" class="list-row-title">PAL</div><div id="pal-r57shell-detail" class="list-row-detail">A European TV signal</div><div id="pal-r57shell-state" class="list-row-state"></div></button>
<button id="lcd-grid-v2" class="list-row "><img class="list-row-icon" src="shaders/lcd-grid-v2/icon.png"/><div id="lcd-grid-v2-title" class="list-row-title">LCD GRID</div><div id="lcd-grid-v2-detail" class="list-row-detail">A handheld screen's pixel grid</div><div id="lcd-grid-v2-state" class="list-row-state"></div></button>
<button id="zfast-lcd" class="list-row "><img class="list-row-icon" src="shaders/zfast-lcd/icon.png"/><div id="zfast-lcd-title" class="list-row-title">ZFAST LCD</div><div id="zfast-lcd-detail" class="list-row-detail">A light handheld screen</div><div id="zfast-lcd-state" class="list-row-state"></div></button>
<button id="gameboy" class="list-row "><img class="list-row-icon" src="shaders/gameboy/icon.png"/><div id="gameboy-title" class="list-row-title">DOT MATRIX</div><div id="gameboy-detail" class="list-row-detail">The green handheld screen</div><div id="gameboy-state" class="list-row-state"></div></button>
<button id="sharp-bilinear-simple" class="list-row selected"><img class="list-row-icon" src="shaders/sharp-bilinear-simple/icon.png"/><div id="sharp-bilinear-simple-title" class="list-row-title">SHARP PIXELS</div><div id="sharp-bilinear-simple-detail" class="list-row-detail">Even pixels at any size</div><div id="sharp-bilinear-simple-state" class="list-row-state">ON</div></button>
</div><div id="shaders-pager" class="list-pager" style="display:none;"><button id="shaders-prev" class="menu-action list-pager-prev">&lt;</button><div id="shaders-page-count" class="list-pager-count"></div><button id="shaders-next" class="menu-action list-pager-next">&gt;</button></div></div><div class="list-actions"><button class="menu-action list-back" id="shaders-back">BACK</button></div><div id="shaders-status" class="list-status"></div></div><div id="achievements-panel" class="screen-panel" style="display:none;">
  <div class="list account-screen">
    <div class="account-summary"><span id="achievements-account">RETROACHIEVEMENTS</span><span id="achievements-state" class="account-state">OFF</span></div>
    <div id="achievements-signed-out" class="account-empty">
      <div>Sign in to earn achievements.</div>
      <button id="achievements-login" class="menu-action account-action">SIGN IN TO ENABLE</button>
      <button id="achievements-quick" class="menu-action account-action" style="display:none;">QUICK SIGN IN</button>
    </div>
    <div id="achievements-form" class="account-form" style="display:none;">
      <label for="achievement-username">USERNAME</label>
      <input id="achievement-username" type="text" maxlength="95" class="account-input"/>
      <label for="achievement-password">PASSWORD</label>
      <div class="account-password-row"><input id="achievement-password" type="password" class="account-input"/><button id="achievements-password-visibility" class="menu-action account-reveal">SHOW</button></div>
      <div class="account-form-actions"><button id="achievements-submit" class="menu-action">SIGN IN</button><button id="achievements-cancel" class="menu-action">CANCEL</button></div>
      <div class="account-help">Create an account at retroachievements.org</div>
      <div id="achievements-error" class="account-error"></div>
    </div>
    <div id="achievements-catalog" class="account-catalog" style="display:none;"><div id="achievements-list" class="list live-list" data-page-size="7"><div class="list-prototype" style="display:none;"><button id="achievements-prototype" class="list-row "><div class="list-row-wait"><div class="list-row-wait-cells"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></div><div id="achievements-prototype-title" class="list-row-title"></div><div id="achievements-prototype-detail" class="list-row-detail"></div><div id="achievements-prototype-state" class="list-row-state"></div></button>
</div><div id="achievements-pager" class="list-pager" style="display:none;"><button id="achievements-prev" class="menu-action list-pager-prev">&lt;</button><div id="achievements-page-count" class="list-pager-count"></div><button id="achievements-next" class="menu-action list-pager-next">&gt;</button></div></div><div class="account-none">There are no achievements.</div></div>
  </div>
  <div class="list-actions"><div id="achievements-session-actions" class="account-session-actions" style="display:none;">
  <button id="achievements-enabled" class="menu-action list-control account-toggle">TURN OFF</button>
  <button id="achievements-retry" class="menu-action list-control account-retry" style="display:none;">RETRY</button>
  <button id="achievements-signout" class="menu-action list-control account-signout">SIGN OUT</button>
</div><button class="menu-action list-back" id="achievements-back">BACK</button></div><div id="achievements-status" class="list-status"></div>
</div>
