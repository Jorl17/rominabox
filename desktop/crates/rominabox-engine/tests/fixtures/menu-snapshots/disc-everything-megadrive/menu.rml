<button id="crt-lottes" class="list-row "><img class="list-row-icon" src="shaders/crt-lottes/icon.png"/><div id="crt-lottes-title" class="list-row-title">CRT LOTTES</div><div id="crt-lottes-detail" class="list-row-detail">An arcade monitor</div><div id="crt-lottes-state" class="list-row-state"></div></button>
