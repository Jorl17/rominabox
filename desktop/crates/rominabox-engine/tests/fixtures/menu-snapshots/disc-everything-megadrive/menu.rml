nel" style="display:none;"><div id="shaders-list" class="list" data-page-size="5"><div class="list-page"><button id="none" class="list-row "><img class="list-row-icon" src="shaders/none/icon.png"/><div id="none-title" class="list-row-title">UNFILTERED</div><div id="none-detail" class="list-row-detail">The picture as the console draws it</div><div id="none-state" class="list-row-state"></div></button>
