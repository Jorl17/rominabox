  <div class="session-dialog-title">ACHIEVEMENTS NOT SYNCED</div>
  <div id="achievements-confirmation-copy" class="session-dialog-copy">Some earned achievements have not reached RetroAchievements. They may be lost if you end this session.</div>
  <div class="session-dialog-actions"><button id="achievements-keep-session" class="menu-action">KEEP PLAYING</button><button id="achievements-end-session" class="menu-action">QUIT ANYWAY</button></div>
</div>
