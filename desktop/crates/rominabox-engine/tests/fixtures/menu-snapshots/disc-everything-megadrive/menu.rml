<button id="crt-aperture" class="list-row "><img class="list-row-icon" src="shaders/crt-aperture/icon.png"/><div id="crt-aperture-title" class="list-row-title">CRT APERTURE</div><div id="crt-aperture-detail" class="list-row-detail">A studio monitor's fine grille</div><div id="crt-aperture-state" class="list-row-state"></div></button>
