<div class="control-leader horizontal" style="left:216dp;top:210dp;width:117dp;"/>
<div class="control-leader vertical" style="left:333dp;top:203dp;height:7dp;"/>
<button id="control-down" class="control-callout" style="left:16dp;top:184dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down"></span></div><div id="control-hit-down" class="control-hit" style="left:294dp;top:-4dp;pointer-events:none;"/><div id="control-reach-down" class="control-reach" style="position:absolute;left:305dp;top:7dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:569dp;top:294dp;width:175dp;"/>
<div class="control-leader vertical" style="left:569dp;top:213dp;height:81dp;"/>
