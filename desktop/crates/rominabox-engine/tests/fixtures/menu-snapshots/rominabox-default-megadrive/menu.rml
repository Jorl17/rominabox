</div><div id="binds-pager" class="list-pager" style="display:none;"><button id="binds-prev" class="menu-action list-pager-prev">&lt;<span class="binding-badge"><span class="binding-key" data-binding="previous-page">Pg Up</span></span></button><div id="binds-page-count" class="list-pager-count"></div><button id="binds-next" class="menu-action list-pager-next">&gt;<span class="binding-badge"><span class="binding-key" data-binding="next-page">Pg Down</span></span></button></div></div><div id="controls-actions"><button class="menu-action" id="controls-back">BACK<span class="binding-badge"><span class="binding-key" data-binding="back">Esc</span></span></button><button class="menu-action" id="controls-reset">RESET DEFAULTS</button><button class="menu-action" id="controls-cancel" style="display:none;">CANCEL</button></div><div id="controls-status">CHOOSE A CONTROL</div></div><div id="hotkeys-panel" class="screen-panel" style="display:none;"><div id="hotkeys-list" class="list" data-page-size="4"><div class="list-page"><div id="hotkey-menu" class="hotkey"><div class="hotkey-label"><span id="hotkey-menu-label">MENU</span></div><div class="hotkey-chips"><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-menu-1"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-menu-2"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-menu-3"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-menu-4"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-menu-5"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-add" id="hotkey-menu-add">+</button></div></div><div id="hotkey-confirm" class="hotkey"><div class="hotkey-label"><span id="hotkey-confirm-label">CONFIRM</span></div><div class="hotkey-chips"><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-confirm-1"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-confirm-2"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-confirm-3"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-confirm-4"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-confirm-5"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-add" id="hotkey-confirm-add">+</button></div></div><div id="hotkey-back" class="hotkey"><div class="hotkey-label"><span id="hotkey-back-label">BACK</span></div><div class="hotkey-chips"><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-back-1"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-back-2"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-back-3"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-back-4"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button class="menu-action hotkey-chip" style="display:none;" id="hotkey-back-5"><span class="hotkey-words"></span><span class="hotkey-mark">×</span></button><button