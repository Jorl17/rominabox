<div class="control-leader horizontal" style="left:587dp;top:42dp;width:157dp;"/>
<div class="control-leader vertical" style="left:587dp;top:42dp;height:69dp;"/>
<button id="control-start" class="control-callout" style="left:744dp;top:16dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start"></span></div><div id="control-hit-start" class="control-hit" style="left:-180dp;top:72dp;pointer-events:none;"/><div id="control-reach-start" class="control-reach" style="position:absolute;left:-173dp;top:79dp;width:28dp;height:28dp;"/></button></div><div id="control-binds" class="list" style="display:none;" data-page-size="5"><div class="list-page"><button id="bind-1" class="list-row "><div id="bind-1-title" class="list-row-title"></div><div id="bind-1-detail" class="list-row-detail"></div><div id="bind-1-state" class="list-row-state"></div></button>
<button id="bind-2" class="list-row "><div id="bind-2-title" class="list-row-title"></div><div id="bind-2-detail" class="list-row-detail"></div><div id="bind-2-state" class="list-row-state"></div></button>
<button id="bind-3" class="list-row "><div id="bind-3-title" class="list-row-title"></div><div id="bind-3-detail" class="list-row-detail"></div><div id="bind-3-state" class="list-row-state"></div></button>
<button id="bind-4" class="list-row "><div id="bind-4-title" class="list-row-title"></div><div id="bind-4-detail" class="list-row-detail"></div><div id="bind-4-state" class="list-row-state"></div></button>
<button id="bind-5" class="list-row "><div id="bind-5-title" class="list-row-title"></div><div id="bind-5-detail" class="list-row-detail"></div><div id="bind-5-state" class="list-row-state"></div></button>
