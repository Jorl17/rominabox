div { display: block; }
body { margin: 0; width: 100%; height: 100%; font-family: Silkscreen; font-size: 16dp; color: #ffffff; background-color: #041738; }
/* The field fills the window at any aspect ratio. The slots stay at the left,
 * and the button column stays at the right edge. */
#screen { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #1049c3; }
#spine { position: absolute; left: 0; top: 0; width: 8dp; height: 100%; background-color: #5296ef; z-index: 3; }

/* An overlay is this design drawn over a running game. In the player we add
 * `showing`, later `leaving`, and `overlay` on the body while the menu is
 * closed. Its arrival, its exit and its position are defined here. */
body.overlay { background-color: transparent; }
body.overlay #screen { background-color: transparent; }
body.overlay #spine, body.overlay #heading, body.overlay #footer,
body.overlay #pause-panel, body.overlay #controls-panel,
body.overlay #options-panel, body.overlay #disc-panel,
body.overlay .screen-panel { display: none; }

#splash { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 100; background-color: #041738; opacity: 0; transition: opacity 0.1s linear-in-out; }
#splash.showing { display: block; opacity: 1; }
#splash.leaving { display: block; opacity: 0; transition: opacity 0.18s linear-in-out; }
#splash-logo { position: absolute; right: 48dp; bottom: 36dp; width: 220dp; height: 220dp; }
/* The ROM-in-a-Box name in its lettering, Science Gothic, next to the logo,
 * centred on its box, where the eye sees the middle of the logo, and as far
 * from the box wall, for its size, as the name in Native is from its logo. */
#splash-name { position: absolute; right: 266.5dp; bottom: 92dp; text-align: right; font-family: "Science Gothic"; font-weight: bold; font-size: 30dp; color: #ffffff; }

/* A thin strip along the top edge, like the short prompts of a disc console.
 * It slides down into view and back up out of it. */
.notice { position: absolute; right: 16dp; top: -44dp; width: 300dp; height: 32dp; z-index: 90; pointer-events: none; opacity: 0; line-height: 32dp; text-align: center; font-family: Silkscreen; font-size: 13dp; color: #ffffff; background-color: #061a48; border-bottom: 2dp #fff13d; transition: top opacity 0.2s cubic-out; }
body.overlay .notice.showing { opacity: 1; top: 0; }
body.overlay .notice.leaving { opacity: 0; top: -44dp; transition: top opacity 0.28s cubic-in; }

#heading { position: absolute; top: 10dp; left: 24dp; width: 700dp; height: 28dp; line-height: 28dp; text-align: left; font-size: 22dp; color: #ffffff; }

/* Six blocks, two across and three down, with the picture next to the words.
 * The picture area is 138dp tall because in the player we measure the game
 * aspect, limit the height to 138 and write it on the parent of the picture.
 * A shorter row would cut off the save picture. */
#slots { position: absolute; left: 20dp; top: 46dp; width: 730dp; height: 492dp; }
.slot { position: absolute; width: 360dp; height: 156dp; padding: 0; overflow: hidden; background-color: #061a48; color: #ffffff; border-width: 1dp; border-color: #476eab; font-family: Silkscreen; text-align: left; }
#slot-1, #slot-3, #slot-5 { left: 0; }
#slot-2, #slot-4, #slot-6 { left: 368dp; }
#slot-1, #slot-2 { top: 0; }
#slot-3, #slot-4 { top: 164dp; }
#slot-5, #slot-6 { top: 328dp; }
.slot:hover { border-color: #75b2e4; }
.slot.focused { background-color: #193e88; border-color: #fff13d; border-left-width: 6dp; }
.slot:active { background-color: #fff13d; color: #081433; }
.slot-label { position: absolute; left: 248dp; top: 36dp; height: 24dp; font-size: 16dp; color: #ffffff; }
/* The slot SAVE and LOAD use has its words in the pale colour. */
.slot.selected .slot-label { color: #b4e6ff; }
.slot.focused .slot-label { color: #fff13d; }
.slot:active .slot-label { color: #081433; }
/* The picture has the aspect of the game, as large as its max-width and
 * max-height allow. Its width and height are those of a 4:3 game, as in a
 * preview. Its frame has room for the largest picture in its bevel, and the
 * picture is at the left edge of the frame, centred vertically. */
.slot-frame { position: absolute; left: 8dp; top: 8dp; height: 140dp; display: flex; align-items: center; }
.slot-picture { width: 184dp; height: 138dp; max-width: 230dp; max-height: 138dp; background-color: #0865bf; border-top: 1dp #020b27; border-left: 1dp #020b27; border-right: 1dp #9edaff; border-bottom: 1dp #9edaff; }
.slot-image { width: 100%; height: 100%; }
.slot.empty .slot-image { display: none; }
.slot-state { position: absolute; left: 248dp; top: 78dp; height: 20dp; font-size: 13dp; color: #b4e6ff; }
.slot.disabled .slot-state { right: 12dp; height: auto; font-size: 11dp; white-space: normal; }
.slot:active .slot-state { color: #081433; }

#actions { position: absolute; right: 24dp; top: 46dp; width: 176dp; height: 300dp; }
/* One column with the buttons of the game, 44dp apart, so in a game with
 * no Options entries the column closes up and leaves no gap. */
#actions button { display: block; position: relative; margin-bottom: 6dp; width: 176dp; height: 36dp; line-height: 36dp; text-align: left; padding-left: 12dp; font-family: Silkscreen; font-size: 14dp; }

#status { position: absolute; left: 24dp; top: 544dp; width: 700dp; text-align: left; font-size: 13dp; color: #b4e6ff; }
#footer { position: absolute; left: 24dp; bottom: 8dp; width: 912dp; height: 20dp; font-size: 13dp; color: #75b2e4; }
#version { position: absolute; right: 0; top: 0; }
/* The key in a hint, the ESC of "[ESC]  BACK", as a keycap in the colour of
 * the lettering, so the key and its action look like two separate things. */
.hint-key { padding: 0 3.2dp; background-color: #75b2e4; color: #041738; }
/* The ROM-in-a-Box mark next to its name, pixel art on the pixel grid of the
 * lettering (1.6dp), in its colour, one space away plus the one-pixel side
 * bearing of a glyph, and two pixels down to centre it on the capitals. */
#brand-mark { width: 20.8dp; height: 14.4dp; margin-right: 1.6dp; vertical-align: -3.2dp; image-color: #75b2e4; }

#controller-scene { position: absolute; left: 0; top: 44dp; width: 960dp; height: 380dp; }
#controller-image { position: absolute; left: 0; top: 0; width: 960dp; height: 380dp; }
.control-leader { position: absolute; background-color: #476eab; }
.control-leader.horizontal { height: 1dp; }
.control-leader.vertical { width: 1dp; }
.control-hit { position: absolute; box-sizing: border-box; width: 30dp; height: 30dp; background-color: transparent; border: 1dp transparent; border-radius: 15dp; }
.control-callout:hover .control-hit, .control-group:hover .control-hit { border-color: #75b2e4; border-width: 2dp; }
.control-callout.focused .control-hit, .control-group.focused .control-hit { border-color: #fff13d; border-width: 2dp; margin-left: -3dp; }
/* A lit ring has a crisp dark edge outside and inside, so it is visible on a
 * pale pad as well as on a dark one. */
.control-callout:hover .control-hit, .control-group:hover .control-hit,
.control-callout.focused .control-hit, .control-group.focused .control-hit { box-shadow: #020b27 0dp 0dp 0dp 1dp, #020b27 0dp 0dp 0dp 1dp inset; }
/* The thicker left edge of the focused box moves its content to the right.
 * The ring and the area for the pointer stay on the button. */
.control-callout.focused .control-reach, .control-group.focused .control-reach { margin-left: -3dp; }
.control-callout { position: absolute; width: 188dp; height: 36dp; padding: 0; border-width: 1dp; border-color: #476eab; color: #ffffff; background-color: #061a48; font-family: Silkscreen; text-align: left; }
.control-callout:hover { border-color: #75b2e4; z-index: 2; }
/* Later controls are later siblings and would cover the focused edge of
 * the control before them, so we draw focus and the pointer above the
 * neighbours. The open list is at 60. */
.control-callout.focused { border-color: #fff13d; border-left-width: 4dp; border-left-color: #fff13d; z-index: 2; }

/* Below the scene, in the band without callouts. The list opens upward from
 * here and ends before the d-pad, so when a drag ends off the list, the
 * button under the pointer still shows the hover state. */
.control-picker { position: absolute; left: 24dp; top: 508dp; width: 320dp; height: 36dp; z-index: 50; }
.control-picker-label { position: absolute; left: 0; top: -16dp; font-size: 11dp; color: #b4e6ff; }
.control-picker-current { position: absolute; left: 0; right: 0; top: 0; height: 32dp; font-family: Silkscreen; font-size: 13dp; line-height: 32dp; white-space: nowrap; text-align: left; padding-left: 10dp; border-width: 1dp; border-color: #476eab; background-color: #061a48; color: #ffffff; }
.control-picker-current:hover { border-color: #75b2e4; color: #fff13d; }
.control-picker-current.focused { border-left-width: 4dp; border-left-color: #fff13d; }
.control-picker-current:active { background-color: #fff13d; color: #081433; border-color: #fff13d; }
.control-picker-list { position: absolute; left: 0; right: 0; bottom: 100%; border-width: 1dp; border-color: #fff13d; background-color: #061a48; z-index: 50; display: block; }
.control-picker-option { display: block; position: relative; height: 26dp; font-family: Silkscreen; font-size: 13dp; line-height: 26dp; white-space: nowrap; text-align: left; padding-left: 12dp; border-left: 4dp #061a48; background-color: #061a48; color: #b4e6ff; }
.control-picker-option + .control-picker-option { border-top: 1dp #476eab; }
.control-picker-option:hover { color: #ffffff; border-bottom: 2dp #75b2e4; }
.control-picker-option.focused { color: #ffffff; background-color: #193e88; border-left-color: #fff13d; }
.control-picker-option:active { background-color: #fff13d; color: #081433; border-left-color: #ffffff; }
.control-picker-option.selected { color: #fff13d; }
.control-picker-option.selected:hover, .control-picker-option.selected.focused { color: #fff13d; }
.control-picker-option.selected:active { color: #081433; }

.control-group { position: absolute; width: 210dp; height: 44dp; padding: 0; border-width: 1dp; border-color: #476eab; color: #ffffff; background-color: #061a48; font-family: Silkscreen; text-align: left; }
.control-group:hover { border-color: #75b2e4; z-index: 2; }
.control-group.focused { border-color: #fff13d; border-left-width: 4dp; border-left-color: #fff13d; z-index: 2; }
.control-label { margin-left: 8dp; margin-top: 2dp; height: 18dp; font-size: 13dp; overflow: hidden; white-space: nowrap; }
.control-assignment { margin-left: 8dp; font-size: 12dp; color: #b4e6ff; white-space: nowrap; overflow: hidden; }
.control-original { margin-right: 8dp; color: #fff13d; }
/* BACK is in the same place as in Index, and the other two are to its left. */
#controls-actions { position: absolute; left: 360dp; top: 508dp; width: 584dp; height: 38dp; }
#controls-actions button { position: absolute; top: 0; height: 36dp; line-height: 36dp; font-family: Silkscreen; font-size: 13dp; border-width: 1dp; text-align: center; }
#controls-back { left: 406dp; width: 176dp; font-size: 14dp; }
#controls-reset { left: 0; width: 180dp; }
#controls-cancel { left: 192dp; width: 110dp; }
#controls-status { position: absolute; left: 24dp; top: 548dp; width: 700dp; font-size: 13dp; color: #b4e6ff; text-align: left; }

.menu-action { color: #ffffff; background-color: #061a48; border-width: 1dp; border-color: #476eab; }
.menu-action:hover { background-color: #fff13d; color: #081433; border-color: #fff13d; }
/* The focus is on the control being captured. CANCEL also has the capturing
 * class while we wait for a capture, but stays an ordinary button next to it. */
.menu-action.focused { background-color: #193e88; color: #ffffff; border-color: #fff13d; border-left-width: 4dp; }
.menu-action:active { background-color: #193e88; color: #fff13d; border-color: #ffffff; }
.menu-action.disabled, .menu-action:disabled { color: #647cad; border-color: #476eab; background-color: #092754; }

@keyframes capture-pulse { from { border-color: #fff13d; } to { border-color: #476eab; } }
.control-callout.capturing, .control-callout.capturing .control-hit,
.control-group.capturing, .control-group.capturing .control-hit { animation: 0.55s capture-pulse infinite alternate; }

/* The marks of a stick, visible while we capture the stick, with the member
 * being captured blinking. Each arrow is a triangle made of one coloured
 * border, 3dp outside the ring on its side, and the click is a central dot. */
@keyframes mark-blink { from { opacity: 1; } to { opacity: 0.15; } }
.control-direction { position: absolute; display: none; width: 0dp; height: 0dp; border-width: 0dp; border-color: transparent; pointer-events: none; }
.control-group.capturing .control-direction { display: block; opacity: 0.3; }
.control-group.capturing .control-direction.capturing { opacity: 1; animation: 0.55s mark-blink infinite alternate; }
.direction-up { margin-left: -7dp; margin-top: -11dp; border-left-width: 7dp; border-right-width: 7dp; border-bottom-width: 8dp; border-bottom-color: #fff13d; }
.direction-down { margin-left: -7dp; margin-top: 3dp; border-left-width: 7dp; border-right-width: 7dp; border-top-width: 8dp; border-top-color: #fff13d; }
.direction-left { margin-top: -7dp; margin-left: -11dp; border-top-width: 7dp; border-bottom-width: 7dp; border-right-width: 8dp; border-right-color: #fff13d; }
.direction-right { margin-top: -7dp; margin-left: 3dp; border-top-width: 7dp; border-bottom-width: 7dp; border-left-width: 8dp; border-left-color: #fff13d; }
.direction-press { width: 6dp; height: 6dp; margin-left: -3dp; margin-top: -3dp; background-color: #fff13d; }

/* One list for every screen with a list. We write the rows when we bundle
 * the game, and no screen has a separate list style. */
.screen-link { position: absolute; top: 10dp; right: 16dp; width: 140dp; height: 28dp; z-index: 2; font-family: Silkscreen; font-size: 12dp; line-height: 28dp; text-align: center; }
/* As wide as the screen's content, to BACK's right edge. */
.list { position: absolute; left: 24dp; top: 52dp; width: 920dp; }
.list-row { display: block; position: relative; width: 100%; height: 48dp; margin: 0 0 4dp 0; padding: 0; background-color: #061a48; color: #ffffff; border-width: 0 0 1dp 0; border-color: #476eab; font-family: Silkscreen; text-align: left; }
/* The pointer moves the same focus as the keys, so a border here would
 * show a second selected row. We draw the left accent outside the row,
 * because a left border alone shrinks the content box, and the name would
 * start further right than the names above and below it. The same margin
 * moves the row back. */
.list-row:hover { }
.list-row.focused { background-color: #193e88; border-left-width: 4dp; border-left-color: #fff13d; border-bottom-color: #fff13d; margin-left: -4dp; }
.list-row:active { background-color: #fff13d; color: #081433; }
.list-row-icon, .list-row-wait { position: absolute; left: 8dp; top: 8dp; width: 32dp; height: 32dp; }
.list-row-wait { width: 24dp; height: 24dp; padding: 4dp; }
.list-row-title { position: absolute; left: 52dp; top: 6dp; font-size: 14dp; color: #ffffff; }
/* A row with no picture and no second line. We set the right edge on this
 * class, not on the disc list, because the bind list has the same title
 * class, and a right edge there would cut off the end of a control name. */
.list-row.line { height: 28dp; }
.list-row.line .list-row-title { left: 12dp; right: 64dp; top: 0; height: 28dp; line-height: 28dp; white-space: nowrap; overflow: hidden; }
.list-row.line .list-row-detail { display: none; }
.list-row.line .list-row-state { top: 0; height: 28dp; line-height: 28dp; }
.list-row-detail { position: absolute; left: 52dp; top: 26dp; font-size: 12dp; color: #b4e6ff; }
.list-row-state { position: absolute; right: 12dp; top: 16dp; font-size: 12dp; color: #fff13d; }
/* The pager is at the left of the button row, 508dp down the screen. A list
 * starts 52dp down, so that is 456dp into it. The achievements list is in the
 * list box of the account screen, at the same place, so we place its pager
 * against that box and it is on the same row. The shared achievements
 * stylesheet comes after this one, so we add the extra class. */
.list-pager { position: absolute; left: 0; top: 456dp; width: 100%; height: 32dp; }
.account-screen .account-catalog .list { position: static; }
.account-screen .account-catalog .list-pager { position: absolute; top: 456dp; margin-top: 0; }
.list-pager-prev, .list-pager-next, .list-pager-count { position: absolute; top: 0; height: 32dp; line-height: 32dp; background-color: #061a48; color: #ffffff; border-width: 1dp; border-color: #476eab; font-family: Silkscreen; font-size: 13dp; text-align: center; }
.list-pager-prev { left: 0; width: 64dp; }
.list-pager-count { left: 72dp; width: 100dp; }
.list-pager-next { left: 180dp; width: 64dp; }
.list-pager-prev:hover, .list-pager-next:hover { background-color: #fff13d; color: #081433; border-color: #fff13d; }
.list-pager-prev.focused, .list-pager-next.focused { border-left-width: 4dp; border-left-color: #fff13d; }
/* BACK is in the same place as in Index on every screen, and the other
 * actions are to its left in the same band. In a list shorter than a page the
 * action row moves up by the missing rows (an inline margin), so the row is
 * not a positioned box here, and we place each action on the field itself. */
.list-actions { position: static; }
.list-actions .menu-action { position: absolute; left: 578dp; top: 508dp; width: 176dp; height: 36dp; font-family: Silkscreen; font-size: 14dp; line-height: 36dp; text-align: center; border-width: 1dp; }
.list-actions .list-back { left: 766dp; }
#achievements-panel .list-actions .account-toggle, #achievements-panel .list-actions .account-retry { left: 390dp; width: 176dp; }
#achievements-panel .list-actions .account-signout { left: 578dp; width: 176dp; }
#achievements-panel #achievements-back { left: 766dp; right: auto; width: 176dp; }
.list-status { position: absolute; left: 24dp; top: 544dp; color: #b4e6ff; font-size: 13dp; }

/* The index has pages like every other list. Six entries of one height, 61dp
 * apart, end 34dp above the volume row, and a seventh goes to the next page.
 * The pager is at the left of the button row, as in every Disc list. A long
 * label stays on its line. */
.menu-index { position: absolute; left: 24dp; top: 56dp; width: 680dp; height: 358dp; }
.menu-index .list { position: absolute; left: 0; top: 0; width: 680dp; }
.menu-index .list-pager { top: 452dp; }
.option-entry { position: relative; display: block; margin-bottom: 8dp; width: 680dp; height: 26dp; padding-top: 13dp; padding-bottom: 13dp; line-height: 26dp; font-family: Silkscreen; font-size: 18dp; border-width: 0 0 1dp 0; border-color: #476eab; text-align: left; padding-left: 16dp; background-color: transparent; white-space: nowrap; overflow: hidden; }
.option-entry:hover { background-color: #193e88; color: #ffffff; border-color: #75b2e4; }
.option-entry.focused { border-color: #476eab; border-left-width: 6dp; border-left-color: #fff13d; background-color: transparent; color: #ffffff; }
.option-entry:active { background-color: #fff13d; color: #081433; }
.options-back { position: absolute; left: 766dp; top: 508dp; width: 176dp; height: 36dp; line-height: 36dp; font-family: Silkscreen; font-size: 14dp; border-width: 1dp; text-align: center; }

/* We insert volume at the start of Options, in the band under the index,
 * with a rule and no frame, so the list still looks like a list, 24dp away
 * from BACK above it and to its left. The track is
 * 456dp wide because the shared states set the fill and the thumb in pixels
 * for that length. Focus, a thumb being dragged and the pointer look
 * different, because otherwise a player cannot tell them apart. */
#volume-control { position: absolute; left: 24dp; top: 448dp; width: 712dp; height: 32dp; }
.volume-name { position: absolute; left: 0; top: 0; width: 80dp; height: 32dp; line-height: 32dp; font-family: Silkscreen; font-size: 12dp; color: #b4e6ff; }
.volume-end { position: absolute; top: 0; height: 32dp; line-height: 32dp; font-family: Silkscreen; font-size: 12dp; color: #ffffff; white-space: nowrap; overflow: hidden; }
#volume-low { left: 80dp; width: 44dp; }
#volume-high { left: 668dp; width: 44dp; }
.volume-arrow { position: absolute; top: 2dp; width: 28dp; height: 28dp; line-height: 24dp; font-family: Silkscreen; font-size: 13dp; text-align: center; border-width: 1dp; padding: 0; }
#volume-down { left: 128dp; }
#volume-up { left: 632dp; }
#volume-level { position: absolute; left: 164dp; top: 0; width: 456dp; height: 28dp; }
#volume-level-readout { display: none; }
#volume-level > div:last-child { margin-top: 12dp; height: 4dp; background-color: #020b27; border-width: 0 0 1dp 0; border-color: #476eab; }
#volume-level-fill { background-color: #fff13d; }
#volume-level-thumb { top: -6dp; width: 8dp; height: 16dp; background-color: #ffffff; border-width: 1dp; border-color: #75b2e4; }
#volume-level:hover #volume-level-thumb { background-color: #75b2e4; border-color: #fff13d; }
#volume-level.focused #volume-level-thumb { background-color: #193e88; border-color: #fff13d; border-left-width: 3dp; }
#volume-level.dragging #volume-level-thumb { background-color: #fff13d; border-color: #ffffff; }
/* On VIDEO, BRIGHTNESS and CONTRAST in rows like the row of the volume, at
 * the top of the screen, with the percentage at the right end in place of the
 * ends, then SHADERS as an entry like those in Options. */
#brightness-control, #contrast-control { position: absolute; left: 24dp; width: 712dp; height: 32dp; }
#brightness-control { top: 72dp; }
#contrast-control { top: 120dp; }
#brightness-control .volume-name, #contrast-control .volume-name { width: 120dp; }
#brightness-low, #brightness-high, #contrast-low, #contrast-high { display: none; }
#brightness-down, #contrast-down { left: 128dp; }
#brightness-up, #contrast-up { left: 632dp; }
#brightness-level, #contrast-level { position: absolute; left: 164dp; top: 0; width: 456dp; height: 28dp; }
#brightness-level-readout, #contrast-level-readout { position: absolute; left: 504dp; top: 0; width: 48dp; height: 32dp; line-height: 32dp; font-size: 12dp; color: #ffffff; text-align: right; }
#brightness-level > div:last-child, #contrast-level > div:last-child { margin-top: 12dp; height: 4dp; background-color: #020b27; border-width: 0 0 1dp 0; border-color: #476eab; }
#brightness-level-fill, #contrast-level-fill { background-color: #fff13d; }
#brightness-level-thumb, #contrast-level-thumb { top: -6dp; width: 8dp; height: 16dp; background-color: #ffffff; border-width: 1dp; border-color: #75b2e4; }
#brightness-level:hover #brightness-level-thumb, #contrast-level:hover #contrast-level-thumb { background-color: #75b2e4; border-color: #fff13d; }
#brightness-level.focused #brightness-level-thumb, #contrast-level.focused #contrast-level-thumb { background-color: #193e88; border-color: #fff13d; border-left-width: 3dp; }
#brightness-level.dragging #brightness-level-thumb, #contrast-level.dragging #contrast-level-thumb { background-color: #fff13d; border-color: #ffffff; }
.video-shaders { position: absolute; left: 24dp; top: 168dp; }
#video-back { position: absolute; left: 766dp; top: 508dp; width: 176dp; height: 36dp; line-height: 36dp; font-family: Silkscreen; font-size: 14dp; border-width: 1dp; text-align: center; }

#disc-face { position: absolute; left: 250dp; top: 100dp; width: 280dp; height: 280dp; border-radius: 140dp; background-color: #75b2e4; border: 14dp #fff13d; }
#disc-hole { position: absolute; left: 116dp; top: 116dp; width: 48dp; height: 48dp; border-radius: 24dp; background-color: #041738; }
#disc-back { position: absolute; left: 766dp; top: 508dp; width: 176dp; height: 36dp; line-height: 36dp; font-family: Silkscreen; font-size: 14dp; border-width: 1dp; text-align: center; }

/* The bind list, drawn over its control. The rows in Disc are the
   full-width blocks used in the rest of this design, not the thin strips of
   Native, with the same contract in the style of this design. */
#control-binds { z-index: 60; width: 360dp; background-color: #061a48; border-width: 1dp 1dp 1dp 4dp; border-color: #fff13d; }
/* As in Native, with border-box the accent of a focused row stays inside
 * the list. The separator is the bottom border of the row. */
#control-binds .list-row { box-sizing: border-box; height: 30dp; margin: 0; padding: 0; border-width: 0 0 1dp 0; border-color: #476eab; font-size: 13dp; }
#control-binds .list-row-icon { display: none; }
#control-binds .list-row-title { left: 12dp; right: 150dp; top: 0; height: 30dp; line-height: 30dp; font-size: 13dp; color: #ffffff; }
#control-binds .list-row-detail { left: auto; right: 52dp; top: 0; width: 96dp; height: 30dp; line-height: 30dp; font-size: 12dp; text-align: right; color: #b4e6ff; }
#control-binds .list-row-state { right: 10dp; top: 0; width: 38dp; height: 30dp; line-height: 30dp; font-size: 11dp; text-align: right; color: #fff13d; }
#control-binds .list-row:hover { background-color: #193e88; border-color: #75b2e4; }
#control-binds .list-row:active { background-color: #fff13d; color: #081433; }
#control-binds .list-row:active .list-row-title, #control-binds .list-row:active .list-row-detail,
#control-binds .list-row:active .list-row-state { color: #081433; }
#control-binds .list-pager { box-sizing: border-box; position: relative; left: 0; top: 0; width: 100%; height: 28dp; }
#control-binds .list-pager-prev, #control-binds .list-pager-next, #control-binds .list-pager-count { box-sizing: border-box; height: 28dp; line-height: 26dp; font-size: 12dp; top: 0; }
#control-binds .list-pager-prev { left: 0; width: 72dp; }
#control-binds .list-pager-count { left: 80dp; width: 110dp; }
#control-binds .list-pager-next { left: 198dp; width: 72dp; }

/* The inherited achievement notice, with the thin rules and compact type of this design. */
#unlock-row { position: absolute; left: 0; top: 24dp; width: 100%; text-align: center; z-index: 90; }
#unlock { display: inline-block; text-align: left; padding: 8dp; background-color: #061a48; border: 1dp #fff13d; }
#unlock-badge { display: inline-block; vertical-align: top; width: 48dp; height: 48dp; border: 1dp #476eab; }
#unlock-words { display: inline-block; vertical-align: top; margin-left: 12dp; max-width: 560dp; }
#unlock-kicker { font-size: 11dp; color: #fff13d; }
#unlock-title { font-size: 16dp; color: #ffffff; margin-top: 3dp; }
#unlock-detail { font-size: 11dp; color: #b4e6ff; margin-top: 3dp; }
/* The result of a hotkey on the save slots during play, in the same notice,
 * with only its words and no kicker, badge or second line. */
#unlock-row[data-notice=slot] #unlock-kicker, #unlock-row[data-notice=slot] #unlock-detail { display: none; }
#unlock-row[data-notice=slot] #unlock-words { margin-left: 0; }
#unlock-row[data-notice=slot] #unlock-title { margin-top: 0; }
/* The open menu contains the slots, so a notice about them is only for play. */
#unlock-row[data-notice=slot] { display: none; }
body.overlay #unlock-row[data-notice=slot] { display: block; }

/* Arrow moves that the layout alone would get wrong. BACK is right of the
 * volume and the entries are nearer, so Up from it would skip the volume, and
 * Down from QUIT, the last in the column, would go to the bottom block. */
#options-back { nav-up: #volume-level; }
#quit { nav-down: none; }
/* FORGET in QUICK SIGN IN, left of BACK, lit while it is on. */
#accounts-panel .list-actions .account-forget { left: 578dp; width: 176dp; }
.account-forget.on { background-color: #fff13d; color: #081433; }
/* An account is one name to pick, in a large row with the name centred. */
#accounts-list .list-row.line { height: 56dp; margin-bottom: 6dp; }
#accounts-list .list-row.line .list-row-title { left: 0; right: 0; height: 56dp; line-height: 56dp; font-size: 20dp; text-align: center; }
/* The rows on ABOUT have no picture: a name and its licence start at the edge. */
#about-list .list-row-title, #about-list .list-row-detail { left: 12dp; }
/* The web address and where the licence texts are: two lines, clear of the
 * footer. */
#about-status { top: 546dp; font-size: 10dp; line-height: 13dp; }

/* HOTKEYS, drawn like Options in the index. Each hotkey is on a line above
 * a rule, with its name, then its bindings as flat tags and + at the end. A
 * key is a filled tag and a pad input an outlined one, so the two look
 * different without a label. A line with five long tags wraps. Four lines to
 * a page, and the pager at the left of the button row as in every Disc list. */
#hotkeys-list { position: absolute; left: 24dp; top: 56dp; width: 912dp; }
.hotkey { position: relative; height: 96dp; margin-bottom: 8dp; border-width: 0 0 1dp 0; border-color: #476eab; }
.hotkey-label { position: absolute; left: 16dp; top: 0; width: 160dp; height: 96dp; display: flex; align-items: center; line-height: 24dp; font-size: 18dp; color: #ffffff; }
.hotkey-chips { position: absolute; left: 180dp; right: 0; top: 10dp; height: 76dp; display: flex; flex-wrap: wrap; align-content: center; align-items: center; column-gap: 8dp; row-gap: 8dp; }
.hotkey-chip, .hotkey-add { box-sizing: border-box; height: 34dp; line-height: 32dp; font-family: Silkscreen; font-size: 13dp; white-space: nowrap; }
.hotkey-chip { padding: 0 12dp; text-align: left; text-transform: uppercase; }
/* The player cannot choose or remove the fullscreen chord on the row of
 * FULLSCREEN, so we let the pointer pass through it. We do not give it the
 * menu-action class, so we give it the frame of a key chip here. */
.hotkey-chord { pointer-events: none; color: #ffffff; background-color: #061a48; border-width: 1dp; border-color: #476eab; }
.hotkey-chip.pad { background-color: transparent; border-color: #75b2e4; }
.hotkey-chip.pad:hover { background-color: #fff13d; color: #081433; border-color: #fff13d; }
.hotkey-chip.pad.focused { background-color: #193e88; color: #ffffff; border-color: #fff13d; }
.hotkey-add { width: 34dp; padding: 0; text-align: center; font-size: 16dp; }
/* The way of FAST FORWARD, with the height of a chip, at the end of the row.
 * We do not show a hotkey that the game does not have. */
.hotkey-mode { box-sizing: border-box; height: 34dp; line-height: 32dp; padding: 0 12dp; margin-left: auto; font-family: Silkscreen; font-size: 13dp; white-space: nowrap; }
.hotkey.disabled { display: none; }
/* Right at the end of a line stays there, because BACK, far down the right
 * edge, is not the next binding. */
.hotkey-add { nav-right: none; }
.hotkey-add.capturing { animation: 0.55s capture-pulse infinite alternate; }
/* The mark for "choosing this binding removes it". */
.hotkey-mark { margin-left: 8dp; }
#hotkeys-actions { position: absolute; left: 360dp; top: 508dp; width: 584dp; height: 38dp; }
#hotkeys-actions button { position: absolute; top: 0; height: 36dp; line-height: 36dp; font-family: Silkscreen; font-size: 13dp; border-width: 1dp; text-align: center; }
#hotkeys-back { left: 406dp; width: 176dp; font-size: 14dp; }
#hotkeys-reset { left: 0; width: 180dp; }
#hotkeys-cancel { left: 192dp; width: 110dp; }
#hotkeys-status { position: absolute; left: 24dp; top: 548dp; width: 700dp; font-size: 13dp; color: #b4e6ff; text-align: left; }
#hotkeys-list .list-pager { top: 452dp; }

/* On the screens where we ask before UNINSTALL, RESET or RESTART, we show what
 * happens and what stays, then a button to go back and a button to go ahead,
 * under the heading and drawn like the buttons of the pause screen. */
.confirm-copy { position: absolute; left: 24dp; top: 64dp; width: 700dp; font-size: 14dp; line-height: 26dp; color: #ffffff; }
.confirm-stays { top: 136dp; color: #fff13d; }
.confirm-actions { position: absolute; left: 24dp; top: 196dp; width: 700dp; height: 40dp; }
.confirm-actions button { position: absolute; top: 0; width: 176dp; height: 36dp; line-height: 36dp; text-align: left; padding-left: 12dp; font-family: Silkscreen; font-size: 14dp; }
#forget-back, #restart-back { left: 0; }
#forget-confirm, #restart-confirm { left: 200dp; }
/* DATA: EXPORT DATA and IMPORT DATA where the confirm screens have their
 * buttons, the line where we say how it went, and the dialog where we ask
 * before an import, over the page. */
#data-export { left: 0; }
#data-import { left: 200dp; }
.data-status { position: absolute; left: 24dp; top: 260dp; width: 700dp; font-size: 13dp; color: #fff13d; }
.data-dialog { position: absolute; box-sizing: border-box; left: 0; top: 0; width: 100%; height: 100%; padding: 64dp 24dp; z-index: 120; background-color: #1049c3; }
.data-dialog-title { font-size: 18dp; color: #fff13d; margin-bottom: 18dp; }
.data-dialog-copy { font-size: 14dp; line-height: 26dp; max-width: 700dp; color: #ffffff; }
.data-dialog-actions { margin-top: 32dp; }
.data-dialog-actions button { display: inline-block; box-sizing: border-box; width: 176dp; height: 36dp; margin-right: 24dp; line-height: 36dp; text-align: left; padding-left: 12dp; font-family: Silkscreen; font-size: 14dp; }
.data-dialog-actions button.disabled { opacity: 0.4; }
