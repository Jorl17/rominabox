{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROM-in-a-Box",
  "version": "0.4.1",
  "identifier": "com.rominabox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ROM-in-a-Box",
        "width": 1140,
        "height": 820,
        "visible": false,
        "center": true,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.ico"],
    "targets": ["app"],
    "resources": {
      "resources/runtime/": "runtime/",
      "resources/preview/": "preview/",
      "resources/menu-previews/": "menu-previews/",
      "resources/bin/": "bin/",
      "../../licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "template": "windows/installer.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
