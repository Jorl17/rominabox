<img id="controller-image" src="controller-ps1.png"/>
<button id="control-group-l_stick" class="control-group" style="left:264dp;top:328dp;">
<div class="control-label">L STICK</div>
<div id="control-group-binding-l_stick" class="control-assignment">t, g, v, b, 1</div><div class="control-leader vertical" style="left:140dp;top:-103dp;height:102dp;"/><div class="control-leader horizontal" style="left:104dp;top:-1dp;width:36dp;"/><div id="control-hit-l3" class="control-hit" style="left:125dp;top:-118dp;"/>
</button>

<button id="control-group-r_stick" class="control-group" style="left:486dp;top:328dp;">
<div class="control-label">R STICK</div>
<div id="control-group-binding-r_stick" class="control-assignment">i, k, j, l, 2</div><div class="control-leader vertical" style="left:60dp;top:-103dp;height:102dp;"/><div class="control-leader horizontal" style="left:60dp;top:-1dp;width:44dp;"/><div id="control-hit-r3" class="control-hit" style="left:45dp;top:-118dp;"/>
</button>

<button id="control-l" class="control-callout" style="left:16dp;top:0dp;"><div id="control-label-l" class="control-label">L1</div><div class="control-assignment"><span id="control-binding-l">d</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:95dp;"/><div class="control-leader vertical" style="left:284dp;top:17dp;height:28dp;"/><div id="control-hit-l" class="control-hit" style="left:269dp;top:30dp;"/></button>
<button id="control-l2" class="control-callout" style="left:16dp;top:54dp;"><div id="control-label-l2" class="control-label">L2</div><div class="control-assignment"><span id="control-binding-l2">w</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:139dp;"/><div class="control-leader vertical" style="left:328dp;top:-9dp;height:26dp;"/><div id="control-hit-l2" class="control-hit" style="left:313dp;top:-24dp;"/></button>
<button id="control-up" class="control-callout" style="left:16dp;top:108dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:117dp;"/><div class="control-leader vertical" style="left:306dp;top:11dp;height:6dp;"/><div id="control-hit-up" class="control-hit" style="left:291dp;top:-4dp;"/></button>
<button id="control-left" class="control-callout" style="left:16dp;top:162dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:90dp;"/><div class="control-leader vertical" style="left:279dp;top:-16dp;height:33dp;"/><div id="control-hit-left" class="control-hit" style="left:264dp;top:-31dp;"/></button>
<button id="control-right" class="control-callout" style="left:16dp;top:216dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:144dp;"/><div class="control-leader vertical" style="left:333dp;top:-70dp;height:87dp;"/><div id="control-hit-right" class="control-hit" style="left:318dp;top:-85dp;"/></button>
<button id="control-down" class="control-callout" style="left:16dp;top:270dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:117dp;"/><div class="control-leader vertical" style="left:306dp;top:-97dp;height:114dp;"/><div id="control-hit-down" class="control-hit" style="left:291dp;top:-112dp;"/></button>
<button id="control-select" class="control-callout" style="left:16dp;top:324dp;"><div id="control-label-select" class="control-label">Select</div><div class="control-assignment"><span id="control-binding-select">rshift</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:224dp;"/><div class="control-leader vertical" style="left:413dp;top:-169dp;height:186dp;"/><div id="control-hit-select" class="control-hit" style="left:398dp;top:-184dp;"/></button>
<button id="control-r" class="control-callout" style="left:744dp;top:0dp;"><div id="control-label-r" class="control-label">R1</div><div class="control-assignment"><span id="control-binding-r">c</span></div><div class="control-leader horizontal" style="left:-93dp;top:17dp;width:92dp;"/><div class="control-leader vertical" style="left:-93dp;top:17dp;height:28dp;"/><div id="control-hit-r" class="control-hit" style="left:-108dp;top:30dp;"/></button>
<button id="control-r2" class="control-callout" style="left:744dp;top:54dp;"><div id="control-label-r2" class="control-label">R2</div><div class="control-assignment"><span id="control-binding-r2">e</span></div><div class="control-leader horizontal" style="left:-137dp;top:17dp;width:136dp;"/><div class="control-leader vertical" style="left:-137dp;top:-9dp;height:26dp;"/><div id="control-hit-r2" class="control-hit" style="left:-152dp;top:-24dp;"/></button>
<button id="control-x" class="control-callout" style="left:744dp;top:108dp;"><div id="control-label-x" class="control-label">Triangle</div><div class="control-assignment"><span id="control-binding-x">s</span></div><div class="control-leader horizontal" style="left:-113dp;top:17dp;width:112dp;"/><div class="control-leader vertical" style="left:-113dp;top:1dp;height:16dp;"/><div id="control-hit-x" class="control-hit" style="left:-128dp;top:-14dp;"/></button>
<button id="control-a" class="control-callout" style="left:744dp;top:162dp;"><div id="control-label-a" class="control-label">Circle</div><div class="control-assignment"><span id="control-binding-a">x</span></div><div class="control-leader horizontal" style="left:-75dp;top:17dp;width:74dp;"/><div class="control-leader vertical" style="left:-75dp;top:-15dp;height:32dp;"/><div id="control-hit-a" class="control-hit" style="left:-90dp;top:-30dp;"/></button>
<button id="control-y" class="control-callout" style="left:744dp;top:216dp;"><div id="control-label-y" class="control-label">Square</div><div class="control-assignment"><span id="control-binding-y">a</span></div><div class="control-leader horizontal" style="left:-151dp;top:17dp;width:150dp;"/><div class="control-leader vertical" style="left:-151dp;top:-69dp;height:86dp;"/><div id="control-hit-y" class="control-hit" style="left:-166dp;top:-84dp;"/></button>
<button id="control-b" class="control-callout" style="left:744dp;top:270dp;"><div id="control-label-b" class="control-label">Cross</div><div class="control-assignment"><span id="control-binding-b">z</span></div><div class="control-leader horizontal" style="left:-113dp;top:17dp;width:112dp;"/><div class="control-leader vertical" style="left:-113dp;top:-85dp;height:102dp;"/><div id="control-hit-b" class="control-hit" style="left:-128dp;top:-100dp;"/></button>
<button id="control-start" class="control-callout" style="left:744dp;top:324dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div class="control-leader horizontal" style="left:-225dp;top:17dp;width:224dp;"/><div class="control-leader vertical" style="left:-225dp;top:-169dp;height:186dp;"/><div id="control-hit-start" class="control-hit" style="left:-240dp;top:-184dp;"/></button>