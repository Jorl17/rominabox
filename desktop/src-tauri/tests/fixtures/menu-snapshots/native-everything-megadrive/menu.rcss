div { display: block; }
body { margin: 0; width: 100%; height: 100%; font-family: Silkscreen; font-size: 18dp; color: #ffffff; background-color: #041738; }
#screen { position: absolute; left: 50%; top: 50%; margin-left: -480dp; margin-top: -300dp; width: 952dp; height: 592dp; border: 4dp #5296ef; background-color: #1049c3; }

/* An overlay is this design drawn over a running game: the logo while the
 * console starts, and the notice about how to pause. In the player we add
 * `showing`, later `leaving`, then remove both, and we add `overlay` to the
 * body while the menu is not on screen. Everything between those moments is
 * in this stylesheet, so a design can change how an overlay arrives, leaves
 * and where it is. */
body.overlay { background-color: transparent; }
body.overlay #screen { background-color: transparent; border-color: transparent; decorator: none; }
body.overlay #heading, body.overlay #footer, body.overlay #pause-panel,
body.overlay #controls-panel, body.overlay .screen-panel { display: none; }

#splash { display: none; position: absolute; left: -4dp; top: -4dp; width: 960dp; height: 600dp; z-index: 100; background-color: #041738; opacity: 0; transition: opacity 0.12s linear-in-out; }
#splash.showing { display: block; opacity: 1; }
#splash.leaving { display: block; opacity: 0; transition: opacity 0.25s linear-in-out; }
#splash-logo { position: absolute; left: 320dp; top: 96dp; width: 320dp; height: 320dp; }
/* The name ROM-in-a-Box in its lettering, Science Gothic, under the logo. */
#splash-name { position: absolute; left: 0; top: 404dp; width: 100%; text-align: center; font-family: "Science Gothic"; font-weight: bold; font-size: 44dp; color: #ffffff; }

/* Bottom left, where games put a prompt that the player soon stops noticing.
 * It pops up into place and drops back out, because the lettering is stepped
 * and a slow fade would not match it. It does not respond to clicks, and we
 * do not show it over the menu, because the footer of the menu already
 * contains ESC CONTINUE. */
.notice { position: absolute; left: 24dp; bottom: 16dp; width: 276dp; height: 44dp; z-index: 90; pointer-events: none; opacity: 0; line-height: 38dp; text-align: center; font-family: Silkscreen; font-size: 17dp; color: #ffffff; background-color: #061a48; border: 3dp #fff13d; transition: opacity bottom 0.25s cubic-out; }
body.overlay .notice.showing { opacity: 1; bottom: 40dp; }
body.overlay .notice.leaving { opacity: 0; bottom: 16dp; transition: opacity bottom 0.5s cubic-in; }
#heading { position: absolute; top: 16dp; left: 0; width: 100%; text-align: center; font-size: 36dp; color: #fff13d; }
#slots { position: absolute; left: 56dp; top: 76dp; width: 840dp; height: 404dp; }
.slot { position: absolute; width: 252dp; height: 194dp; padding: 0; background-color: #061a48; color: #ffffff; border: 3dp #75b2e4; font-family: Silkscreen; text-align: center; }
#slot-1, #slot-4 { left: 0; }
#slot-2, #slot-5 { left: 291dp; }
#slot-3, #slot-6 { left: 582dp; }
#slot-1, #slot-2, #slot-3 { top: 0; }
#slot-4, #slot-5, #slot-6 { top: 208dp; }
/* The chosen slot is visible only while SAVE or LOAD has the focus. */
.slot.focused, [data-focus=save] .slot.selected, [data-focus=load] .slot.selected { border-color: #fff13d; }
.slot:active { border-top-color: #041738; border-left-color: #041738; border-bottom-color: #ffffff; border-right-color: #ffffff; }
.slot.focused .slot-label, [data-focus=save] .slot.selected .slot-label, [data-focus=load] .slot.selected .slot-label { color: #fff13d; }
.slot-label { height: 24dp; font-size: 17dp; padding-top: 2dp; background-color: #081433; color: #ffffff; }
/* The picture has the aspect ratio of the game, as large as its max-width and
 * max-height allow. Its width and height are those of a 4:3 game, as in a
 * preview. Its frame has room for the largest picture inside its bevel, and
 * the picture is centred in it. */
.slot-frame { height: 142dp; display: flex; justify-content: center; align-items: center; }
.slot-picture { width: 184dp; height: 138dp; max-width: 230dp; max-height: 138dp; background-color: #0865bf; border-top: 2dp #020b27; border-left: 2dp #020b27; border-right: 2dp #9edaff; border-bottom: 2dp #9edaff; }
.slot-image { width: 100%; height: 100%; }
.slot.empty .slot-image { display: none; }
.slot-state { height: 20dp; font-size: 14dp; color: #b4e6ff; padding-top: 2dp; }
#actions { position: absolute; left: 56dp; top: 494dp; width: 840dp; height: 48dp; display: flex; column-gap: 16dp; }
/* Each button is as wide as its label, and they share the rest of the row. */
#actions button { flex: 1 1 auto; text-align: center; line-height: 42dp; height: 42dp; padding: 0 10dp; font-family: Silkscreen; font-size: 17dp; border-width: 3dp; white-space: nowrap; }
#status { position: absolute; top: 547dp; width: 100%; text-align: center; font-size: 16dp; color: #fff13d; }
#footer { position: absolute; left: 24dp; bottom: 10dp; width: 904dp; font-size: 16dp; color: #ffffff; }
#version { position: absolute; right: 0; top: 0; }
/* The key in a hint, the ESC of "[ESC]  BACK", as a keycap in the colour of
 * the lettering, so the key and its action look like two separate things. */
.hint-key { padding: 0 4dp; background-color: #ffffff; color: #1049c3; }
/* The ROM-in-a-Box logo beside the name: pixel art on the same 2dp pixel as
 * the lettering, in its colour, one space away with the one-pixel side
 * bearing of a glyph, and two pixels lower to centre it on the capitals. */
#brand-mark { width: 26dp; height: 18dp; margin-right: 2dp; vertical-align: -4dp; image-color: #ffffff; }

#controller-scene { position: absolute; left: -4dp; top: 80dp; width: 960dp; height: 380dp; }
#controller-image { position: absolute; left: 0; top: 0; width: 960dp; height: 380dp; }
.control-leader { position: absolute; background-color: #b4e6ff; }
.control-leader.horizontal { height: 1dp; }
.control-leader.vertical { width: 1dp; }
.control-hit { position: absolute; box-sizing: border-box; width: 42dp; height: 42dp; background-color: transparent; border: 2dp transparent; border-radius: 21dp; }
.control-callout:hover .control-hit, .control-group:hover .control-hit { border-color: #ffffff; }
.control-callout.focused .control-hit, .control-group.focused .control-hit { border-color: #fff13d; }
/* A lit ring has a crisp dark edge outside and inside, so it is visible on a
 * pale pad as well as on a dark one. */
.control-callout:hover .control-hit, .control-group:hover .control-hit,
.control-callout.focused .control-hit, .control-group.focused .control-hit { box-shadow: #020b27 0dp 0dp 0dp 1dp, #020b27 0dp 0dp 0dp 1dp inset; }
.control-callout { position: absolute; width: 196dp; height: 50dp; padding: 0; border: 2dp #75b2e4; color: #ffffff; background-color: #061a48; font-family: Silkscreen; text-align: left; }
.control-callout:hover { border-color: #ffffff; z-index: 2; }
/* We draw a callout 54dp high with its border, the least distance between
 * two callouts in any console layout, so neighbours touch and the arrow keys
 * reach each in turn. The focused callout and the one under the pointer are
 * above their neighbours. The open list is at 60. */
.control-callout.focused { border-color: #fff13d; z-index: 2; }

/* When closed, the picker is on the action row between RESET DEFAULTS and
 * CANCEL, because the heading is at the top centre and both gutters are full.
 *
 * These are screen coordinates, so the picker is a sibling of
 * #controller-scene. Inside the scene, we would measure them from the origin
 * of the scene. The list opens upward (bottom, not top) because the status
 * line is directly under this row.
 *
 * We set the width once, here, and the button and the list stretch to it.
 * The options have no width, because a fixed width plus the focus border and
 * padding would be wider than the content box of the list. */
.control-picker { position: absolute; left: 484dp; top: 480dp; width: 228dp; height: 42dp; z-index: 50; }
.control-picker-label { position: absolute; left: 0; top: -16dp; font-size: 12dp; color: #b4e6ff; }
/* nowrap, because the widest controller name sets this width, and a name
 * that wrapped would draw its second line outside the border. */
.control-picker-current { position: absolute; left: 0; right: 0; top: 0; height: 38dp; font-family: Silkscreen; font-size: 13dp; line-height: 38dp; white-space: nowrap; text-align: left; padding-left: 8dp; border: 2dp #75b2e4; background-color: #061a48; color: #ffffff; }
.control-picker-current:hover { border-color: #ffffff; }
.control-picker-current.focused { border-color: #fff13d; }
.control-picker-current:active { background-color: #193e88; border-color: #ffffff; }
/* We lay out the options through the list, because block elements inside
 * an absolutely positioned parent would draw on top of one another. */
.control-picker-list { position: absolute; left: 0; right: 0; bottom: 100%; border: 2dp #fff13d; background-color: #061a48; z-index: 50; display: block; }
.control-picker-option { display: block; position: relative; height: 22dp; font-family: Silkscreen; font-size: 13dp; line-height: 22dp; white-space: nowrap; text-align: left; padding-left: 12dp; border-left: 4dp #061a48; background-color: #061a48; color: #b4e6ff; }
/* A hairline between rows. With the adjacent-sibling selector the last row
 * has no hairline, so the yellow list border is the bottom edge. */
.control-picker-option + .control-picker-option { border-top: 1dp #476eab; }
/* The pointer, keyboard focus and a held press are three states, and we draw
 * each differently, so a player using the arrow keys can see which option a
 * press would choose. */
.control-picker-option:hover { background-color: #193e88; color: #ffffff; }
.control-picker-option.focused { background-color: #193e88; color: #ffffff; border-left-color: #fff13d; }
.control-picker-option:active { background-color: #fff13d; color: #061a48; border-left-color: #ffffff; }
.control-picker-option.selected { color: #fff13d; }
/* The controller in use keeps yellow text under the pointer and under the
 * arrow keys, so it still looks in use. During a press the row itself turns
 * yellow and yellow text on it would disappear, so the text is not yellow
 * then. */
.control-picker-option.selected:hover, .control-picker-option.selected.focused { color: #fff13d; }
.control-picker-option.selected:active { color: #061a48; }

/* A stick is one object on the pad but several binds, so we draw it once,
 * under the illustration and not in a gutter. Each gutter is full with seven
 * 54dp callouts, and four directions per stick would cover other buttons. */
.control-group { position: absolute; width: 236dp; height: 62dp; padding: 0; border: 2dp #75b2e4; color: #ffffff; background-color: #061a48; font-family: Silkscreen; text-align: left; }
.control-group:hover { border-color: #ffffff; z-index: 2; }
.control-group.focused { border-color: #fff13d; z-index: 2; }
.control-label { margin-left: 10dp; margin-top: 5dp; height: 24dp; font-size: 18dp; overflow: hidden; white-space: nowrap; }
.control-assignment { margin-left: 10dp; margin-right: 8dp; font-size: 14dp; color: #b4e6ff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.control-original { margin-right: 10dp; color: #fff13d; }
#controls-actions { position: absolute; left: 56dp; top: 480dp; width: 840dp; height: 42dp; }
#controls-actions button { font-family: Silkscreen; font-size: 18dp; height: 38dp; line-height: 38dp; border-width: 2dp; text-align: center; }
#controls-back { position: absolute; left: 0; width: 160dp; }
#controls-reset { position: absolute; left: 216dp; width: 292dp; }
#controls-cancel { position: absolute; right: 0; width: 180dp; }
#controls-status { position: absolute; top: 537dp; width: 100%; font-size: 16dp; color: #fff13d; text-align: center; }

#controls-back { width: 124dp; }
#controls-reset { left: 148dp; width: 256dp; }
#controls-cancel { width: 160dp; }
.slot:active .slot-label { color: #fff13d; }

.menu-action { color: #ffffff; background-color: #061a48; border-color: #75b2e4; }
/* The control being captured has the focus and is the only yellow element.
 * CANCEL also has the capturing class while we wait for an input, but it
 * stays an ordinary button. */
.menu-action:hover, .menu-action.focused { background-color: #fff13d; color: #061a48; border-color: #ffffff; }
.menu-action:active { border-top-color: #041738; border-left-color: #041738; border-bottom-color: #ffffff; border-right-color: #ffffff; }
.menu-action.disabled, .menu-action:disabled { color: #647cad; border-color: #476eab; background-color: #092754; }

/* Volume and the entries under it are one column, so the bar and the
 * entries have the same edges. The entries have one height, however many
 * there are.
 *
 * The label is the name of the level, and LOW and HIGH mark its direction.
 * The track is inset so the thumb at 0 and at 100 clears both arrows. At
 * rest the fill is the whole content box, which is the top, and it stays in
 * that box so the light edge of the bevel runs the full width of the track. */
#volume-control { position: absolute; left: 56dp; top: 104dp; width: 840dp; height: 64dp; background-color: #061a48; border-width: 3dp; border-color: #75b2e4; }
.volume-name { position: absolute; left: 16dp; top: 0; width: 112dp; height: 64dp; line-height: 64dp; font-family: Silkscreen; font-size: 18dp; color: #ffffff; }
.volume-end { position: absolute; top: 0; height: 64dp; line-height: 64dp; font-family: Silkscreen; font-size: 16dp; color: #ffffff; text-align: center; white-space: nowrap; overflow: hidden; }
#volume-low { left: 136dp; width: 56dp; }
#volume-high { left: 748dp; width: 76dp; }
.volume-arrow { position: absolute; top: 10dp; width: 44dp; height: 44dp; line-height: 38dp; font-family: Silkscreen; font-size: 20dp; text-align: center; border-width: 3dp; padding: 0; }
#volume-down { left: 196dp; }
#volume-up { left: 696dp; }
/* Options lists what we bundled with this game, in pages like every other
 * list. The positions are in the design, and we append nothing afterwards
 * that could override them. A page has four entries (design.json), and the
 * gap under VOLUME is the gap between them, 14dp. A full page ends 18dp above
 * BACK, and a fifth entry goes to the next page. The pager is on the same row
 * as BACK, and a long label stays inside its entry. */
#options-entries { position: absolute; left: 56dp; top: 188dp; width: 840dp; height: 274dp; }
#options-entries .list { position: absolute; left: 0; top: 0; width: 840dp; }
.option-entry { position: relative; height: 52dp; width: 840dp; margin-bottom: 14dp; display: flex; align-items: center; justify-content: center; font-family: Silkscreen; font-size: 20dp; border-width: 3dp; white-space: nowrap; overflow: hidden; }
/* BACK's row, 480dp down the screen, is 292dp below the list. */
#options-entries .list-pager { top: 292dp; height: 46dp; }
#options-entries .list-pager-prev, #options-entries .list-pager-next { height: 42dp; line-height: 38dp; }
#options-entries .list-pager-count { height: 46dp; line-height: 42dp; }
#options-entries .list-pager-prev { left: 280dp; }
#options-entries .list-pager-count { left: 360dp; }
#options-entries .list-pager-next { left: 504dp; }
.options-back { position: absolute; left: 56dp; top: 480dp; width: 160dp; height: 42dp; line-height: 38dp; font-family: Silkscreen; font-size: 18dp; border-width: 2dp; text-align: center; }

#volume-control .slider { position: absolute; left: 252dp; top: 14dp; width: 432dp; height: 36dp; }
#volume-control .slider-readout { display: none; }
#volume-control .slider-track { margin-top: 0; height: 28dp; background-color: #020b27; border-top: 4dp #020b27; border-left: 4dp #020b27; border-right: 4dp #9edaff; border-bottom: 4dp #9edaff; }
#volume-control .slider-fill { top: 0; height: 100%; width: 100%; }
/* The shared thumb is sized for the taller track of a slider on a separate
 * screen: 56dp plus borders is 64dp, which would hang 2dp past the bottom of
 * a 64dp row and draw bright yellow over its border. Inside this row the
 * thumb is the height of the row minus a margin at each end. */
#volume-control .slider-thumb { top: -6dp; height: 40dp; }

/* The slider is a shared part. We draw hover, keyboard focus and a held
 * drag differently. */
.slider { display: block; width: 100%; }
.slider-readout { display: block; width: 100%; height: 44dp; font-family: Silkscreen; font-size: 32dp; text-align: center; color: #fff13d; }
.slider-track { display: block; position: relative; width: 100%; height: 32dp; margin-top: 18dp; background-color: #020b27; border-top: 4dp #020b27; border-left: 4dp #020b27; border-right: 4dp #9edaff; border-bottom: 4dp #9edaff; }
.slider-fill { position: absolute; left: 0; top: 0; height: 100%; width: 0; background-color: #fff13d; }
.slider-thumb { position: absolute; top: -12dp; width: 26dp; height: 56dp; background-color: #061a48; border-top: 4dp #ffffff; border-left: 4dp #ffffff; border-right: 4dp #041738; border-bottom: 4dp #041738; }
.slider:hover .slider-thumb { border-color: #ffffff; }
.slider.focused .slider-thumb, .slider.focused:hover .slider-thumb { background-color: #193e88; border-color: #fff13d; }
.slider.dragging .slider-thumb, .slider:active .slider-thumb { background-color: #fff13d; border-top-color: #041738; border-left-color: #041738; border-bottom-color: #ffffff; border-right-color: #ffffff; }
.toggle { display: block; position: relative; width: 260dp; height: 52dp; margin-top: 56dp; margin-left: 230dp; padding-left: 64dp; font-family: Silkscreen; font-size: 18dp; line-height: 46dp; text-align: left; color: #ffffff; background-color: #061a48; border: 3dp #75b2e4; }
.toggle-knob { position: absolute; left: 8dp; top: 6dp; width: 32dp; height: 32dp; background-color: #75b2e4; border-top: 3dp #ffffff; border-left: 3dp #ffffff; border-right: 3dp #041738; border-bottom: 3dp #041738; }
.toggle:hover { border-color: #ffffff; }
.toggle.focused, .toggle.focused:hover { border-color: #fff13d; }
.toggle.on { background-color: #fff13d; color: #061a48; border-color: #ffffff; }
.toggle.on .toggle-knob { left: 212dp; background-color: #061a48; }
.toggle:active .toggle-knob { border-top-color: #041738; border-left-color: #041738; border-bottom-color: #ffffff; border-right-color: #ffffff; }
.toggle-label { font-family: Silkscreen; }

@keyframes capture-pulse { from { border-color: #fff13d; } to { border-color: transparent; } }
.control-callout.capturing, .control-callout.capturing .control-hit,
.control-group.capturing, .control-group.capturing .control-hit { animation: 0.55s capture-pulse infinite alternate; }

/* The marks of a stick, visible while we capture the stick, with the member
 * being captured blinking. Each arrow is a triangle made of one coloured
 * border, 3dp outside the ring on its side, and the click is a central dot. */
@keyframes mark-blink { from { opacity: 1; } to { opacity: 0.15; } }
.control-direction { position: absolute; display: none; width: 0dp; height: 0dp; border-width: 0dp; border-color: transparent; pointer-events: none; }
.control-group.capturing .control-direction { display: block; opacity: 0.3; }
.control-group.capturing .control-direction.capturing { opacity: 1; animation: 0.55s mark-blink infinite alternate; }
.direction-up { margin-left: -7dp; margin-top: -11dp; border-left-width: 7dp; border-right-width: 7dp; border-bottom-width: 8dp; border-bottom-color: #fff13d; }
.direction-down { margin-left: -7dp; margin-top: 3dp; border-left-width: 7dp; border-right-width: 7dp; border-top-width: 8dp; border-top-color: #fff13d; }
.direction-left { margin-top: -7dp; margin-left: -11dp; border-top-width: 7dp; border-bottom-width: 7dp; border-right-width: 8dp; border-right-color: #fff13d; }
.direction-right { margin-top: -7dp; margin-left: 3dp; border-top-width: 7dp; border-bottom-width: 7dp; border-left-width: 8dp; border-left-color: #fff13d; }
.direction-press { width: 6dp; height: 6dp; margin-left: -3dp; margin-top: -3dp; background-color: #fff13d; }

/* The rules for every list screen. The achievement list, the shader list and
 * any later list in Options have the same parts: rows we write when we
 * bundle the game, a pager, and a state on the right. They use these rules,
 * so for a new list we add a new screen and no new stylesheet.
 *
 * These rules are in the design and not in the exporter, so a design can
 * override them for a different list. A design that declares none of them
 * has an unstyled list, and we reject it in the design contract test.
 */
.screen-link { position: absolute; top: 18dp; right: 24dp; width: 148dp; height: 36dp; z-index: 2; font-family: Silkscreen; font-size: 13dp; line-height: 30dp; text-align: center; }
.list { position: absolute; left: 36dp; top: 68dp; width: 880dp; }
.list-row { display: block; position: relative; overflow: hidden; width: 100%; height: 68dp; margin: 0 0 4dp 0; padding: 0; background-color: #061a48; color: #ffffff; border-width: 2dp; border-color: #75b2e4; font-family: Silkscreen; text-align: left; }
/* Moving the pointer sets the same focus as the keys, so a border here would
 * draw a second selected row beside the current disc. */
.list-row:hover { }
.list-row.focused { border-color: #fff13d; }
/* A row with no picture and no second line. Rows with a picture or a second
 * line keep the picture gutter and the two-line height. Any list can use this
 * class, and the disc list is not a special case. */
.list-row.line { height: 32dp; }
.list-row.line .list-row-title { left: 12dp; right: 72dp; top: 0; height: 32dp; line-height: 32dp; }
.list-row.line .list-row-detail { display: none; }
.list-row.line .list-row-state { top: 0; width: 56dp; height: 32dp; line-height: 32dp; }
.list-row:active { border-top-color: #041738; border-left-color: #041738; border-bottom-color: #ffffff; border-right-color: #ffffff; }
/* Four units above, below and to the left, so the picture is in the middle
 * of the row and not on its frame. The bevel is the same as on the save
 * slots, so a badge looks set into the row. */
.list-row-icon, .list-row-wait { position: absolute; left: 4dp; top: 4dp; width: 56dp; height: 56dp; border-top: 2dp #041738; border-left: 2dp #041738; border-right: 2dp #75b2e4; border-bottom: 2dp #75b2e4; }
.list-row-wait { width: 40dp; height: 40dp; padding: 8dp; }
/* Each of the three parts of a row has a column and stays in it. An
 * achievement description can be 149 characters long, and then it wraps to
 * two lines here instead of running under the state text. */
.list-row-title { position: absolute; left: 76dp; right: 164dp; top: 6dp; font-size: 16dp; color: #ffffff; white-space: nowrap; overflow: hidden; }
.list-row-detail { position: absolute; left: 76dp; right: 164dp; top: 33dp; height: 30dp; overflow: hidden; font-size: 12dp; color: #b4e6ff; }
/* The full height of the row, so the word is centred in the line box. The
 * row is 68 units high inside. */
.list-row-state { position: absolute; right: 12dp; top: 0; width: 140dp; height: 68dp; line-height: 68dp; font-size: 12dp; text-align: right; white-space: nowrap; color: #b4e6ff; }
/* We highlight the row that is in effect, such as the shader that is on. A
 * row that is only listed has no highlight. */
.list-row.selected .list-row-state { color: #fff13d; }
/* A row marked in its list, such as the win condition among achievements. */
.list-row.accent .list-row-title { color: #fff13d; }
.list-pager { position: absolute; left: 0; top: 400dp; width: 100%; height: 40dp; }
.list-pager-prev, .list-pager-next, .list-pager-count { position: absolute; top: 0; height: 36dp; line-height: 34dp; font-family: Silkscreen; font-size: 18dp; text-align: center; }
.list-pager-prev, .list-pager-next { background-color: #061a48; color: #ffffff; border-width: 2dp; border-color: #75b2e4; }
.list-pager-prev { left: 300dp; width: 56dp; }
.list-pager-count { left: 380dp; width: 120dp; color: #fff13d; }
.list-pager-next { left: 524dp; width: 56dp; }
.list-pager-prev:hover, .list-pager-next:hover, .list-pager-prev.focused, .list-pager-next.focused { background-color: #fff13d; color: #061a48; border-color: #ffffff; }
.list-pager-prev.disabled, .list-pager-next.disabled { color: #647cad; border-color: #476eab; background-color: #092754; }
.list-actions { position: absolute; left: 36dp; top: 508dp; width: 880dp; height: 40dp; }
.list-actions .menu-action { position: absolute; top: 0; height: 36dp; line-height: 34dp; border-width: 2dp; font-family: Silkscreen; font-size: 18dp; text-align: center; }
/* BACK is at the bottom left on every screen of this design, so the button
 * stays at the same end of the screen when the player leaves a list. */
.list-back { left: 0; width: 196dp; }
/* A switch is as wide as its words and no wider, in proportion to the
 * 200-unit BACK beside it. */
.list-status { position: absolute; left: 36dp; top: 552dp; width: 880dp; text-align: center; color: #fff13d; font-size: 14dp; }

/* The bind list uses the same row as every other list, drawn at the weight
 * of the dropdown of the controller picker. Elsewhere the row stays 68dp
 * high, and this applies only while the row describes a control. */
#control-binds { z-index: 60; border: 2dp #fff13d; background-color: #061a48; width: 280dp; }
/* Without this, width 100% is the content box and the 4dp accent is drawn
 * outside it. With border-box the accent is inside the 100%, so the row is as
 * wide as the list. */
#control-binds .list-row { box-sizing: border-box; height: 22dp; margin: 0; border-width: 0 0 0 4dp; border-color: #061a48; font-size: 13dp; line-height: 22dp; }
#control-binds .list-row + .list-row { border-top: 1dp #476eab; }
#control-binds .list-row-icon { display: none; }
#control-binds .list-row-title { left: 8dp; right: 120dp; top: 0; height: 22dp; line-height: 22dp; font-size: 13dp; color: #ffffff; }
#control-binds .list-row-detail { left: auto; right: 44dp; top: 0; width: 84dp; height: 22dp; line-height: 22dp; font-size: 13dp; text-align: right; color: #b4e6ff; }
#control-binds .list-row-state { right: 6dp; top: 0; width: 36dp; height: 22dp; line-height: 22dp; font-size: 11dp; text-align: right; color: #b4e6ff; }
#control-binds .list-row:hover { background-color: #193e88; color: #ffffff; border-left-color: #061a48; }
#control-binds .list-row:active { background-color: #fff13d; color: #061a48; border-color: #fff13d; border-left-color: #ffffff; }
#control-binds .list-row:hover .list-row-detail,
#control-binds .list-row:hover .list-row-state { color: #ffffff; }
#control-binds .list-row:active .list-row-title, #control-binds .list-row:active .list-row-detail,
#control-binds .list-row:active .list-row-state { color: #061a48; }
#control-binds .list-pager { box-sizing: border-box; position: relative; left: 0; top: 0; width: 100%; height: 22dp; }
#control-binds .list-pager-prev, #control-binds .list-pager-next, #control-binds .list-pager-count { box-sizing: border-box; height: 20dp; line-height: 18dp; font-size: 13dp; top: 0; }
#control-binds .list-pager-prev { left: 4dp; width: 56dp; }
#control-binds .list-pager-count { left: 64dp; width: 72dp; }
#control-binds .list-pager-next { left: 140dp; width: 56dp; }

/* A save slot that nobody can use at the moment. The words are in the
 * design, on the switch that disables the slot. */
.slot.disabled, .slot.disabled:hover { border-color: #476eab; }
.slot.disabled .slot-label { background-color: #092754; color: #647cad; }
.slot.disabled .slot-state { color: #647cad; }

/* The achievement unlock notice. Its id is not `notice`, because the boot
 * overlay uses that id.
 *
 * The box is as wide as its contents: it is centred in the row, it is as wide
 * as its words, and a long description wraps.
 */
#unlock-row { position: absolute; left: 0; top: 24dp; width: 100%; text-align: center; z-index: 90; }
#unlock { display: inline-block; text-align: left; padding: 10dp; background-color: #061a48; border: 3dp #fff13d; }
#unlock-badge { display: inline-block; vertical-align: top; width: 64dp; height: 64dp; border-top: 2dp #041738; border-left: 2dp #041738; border-right: 2dp #75b2e4; border-bottom: 2dp #75b2e4; }
#unlock-words { display: inline-block; vertical-align: top; margin-left: 12dp; max-width: 560dp; }
#unlock-kicker { font-size: 12dp; color: #fff13d; }
#unlock-title { font-size: 18dp; color: #ffffff; margin-top: 4dp; }
#unlock-detail { font-size: 12dp; color: #b4e6ff; margin-top: 4dp; }
/* The result of a hotkey on the save slots during play, in the same notice,
 * with only its words and no kicker, badge or second line. */
#unlock-row[data-notice=slot] #unlock-kicker, #unlock-row[data-notice=slot] #unlock-detail { display: none; }
#unlock-row[data-notice=slot] #unlock-words { margin-left: 0; }
#unlock-row[data-notice=slot] #unlock-title { margin-top: 0; }
/* The open menu contains the slots, so a notice about them is only for play. */
#unlock-row[data-notice=slot] { display: none; }
body.overlay #unlock-row[data-notice=slot] { display: block; }
/* Accounts on QUICK SIGN IN: FORGET opposite BACK, lit while it is on. */
#accounts-panel .list-actions .account-forget { left: auto; right: 0; width: 196dp; }
.account-forget.on { background-color: #fff13d; color: #061a48; border-color: #ffffff; }
/* An account is one name to pick, in a large row with the name centred. */
#accounts-list .list-row.line { height: 64dp; margin-bottom: 8dp; }
#accounts-list .list-row.line .list-row-title { left: 0; right: 0; height: 64dp; line-height: 64dp; font-size: 24dp; text-align: center; }

/* HOTKEYS: one panel for each hotkey, with its name on the left and its
 * bindings as keycaps, followed by +. A key is a raised cap and a pad input
 * is a cap set into the panel, so the player can tell them apart without
 * words. Up to five caps fit in two lines, and the + of a full row is dark.
 * A page has four panels, as in Options, and the pager is on the row of
 * buttons, between RESET DEFAULTS and CANCEL. */
#hotkey-rows { position: absolute; left: 56dp; top: 84dp; width: 840dp; }
.hotkey { position: relative; height: 82dp; margin-bottom: 8dp; background-color: #061a48; border: 3dp #75b2e4; }
.hotkey-label { position: absolute; left: 20dp; top: 0; width: 170dp; height: 82dp; display: flex; align-items: center; line-height: 28dp; font-size: 24dp; color: #fff13d; }
.hotkey-chips { position: absolute; left: 196dp; right: 12dp; top: 3dp; height: 76dp; display: flex; flex-wrap: wrap; align-content: center; align-items: center; column-gap: 10dp; row-gap: 6dp; }
.hotkey-chip, .hotkey-add { box-sizing: border-box; height: 35dp; line-height: 29dp; font-family: Silkscreen; font-size: 15dp; text-align: center; white-space: nowrap; }
.hotkey-chip { padding: 0 12dp; text-transform: uppercase; color: #ffffff; background-color: #0865bf; border-width: 3dp; border-top-color: #9edaff; border-left-color: #9edaff; border-right-color: #020b27; border-bottom-color: #020b27; }
.hotkey-chip.pad { background-color: #193e88; border-top-color: #020b27; border-left-color: #020b27; border-right-color: #9edaff; border-bottom-color: #9edaff; }
.hotkey-chip:hover, .hotkey-chip.focused { background-color: #fff13d; color: #061a48; border-color: #ffffff; }
.hotkey-add { width: 35dp; padding: 0; font-size: 22dp; border-width: 3dp; }
.hotkey-add.capturing { animation: 0.55s capture-pulse infinite alternate; }
/* The mark for "choosing this binding removes it". */
.hotkey-mark { margin-left: 10dp; }
#hotkeys-actions { position: absolute; left: 56dp; top: 480dp; width: 840dp; height: 42dp; }
#hotkeys-actions button { position: absolute; top: 0; font-family: Silkscreen; font-size: 18dp; height: 38dp; line-height: 38dp; border-width: 2dp; text-align: center; }
#hotkeys-back { left: 0; width: 124dp; }
#hotkeys-reset { left: 148dp; width: 256dp; }
#hotkeys-cancel { right: 0; width: 160dp; }
#hotkeys-status { position: absolute; top: 537dp; width: 100%; font-size: 16dp; color: #fff13d; text-align: center; }
/* The row of buttons, 480dp down the screen, is 396dp below the panels. */
#hotkey-rows .list-pager { top: 396dp; height: 38dp; }
#hotkey-rows .list-pager-prev, #hotkey-rows .list-pager-next, #hotkey-rows .list-pager-count { height: 38dp; line-height: 34dp; }
#hotkey-rows .list-pager-prev { left: 424dp; }
#hotkey-rows .list-pager-count { left: 488dp; width: 100dp; }
#hotkey-rows .list-pager-next { left: 596dp; }
/* UNINSTALL and RESET: what happens, what stays, then keep the game or forget it. */
.forget-copy { position: absolute; left: 56dp; top: 170dp; width: 840dp; font-size: 18dp; line-height: 32dp; }
.forget-stays { top: 280dp; color: #fff13d; }
.forget-actions { position: absolute; left: 56dp; top: 400dp; width: 840dp; height: 42dp; }
.forget-actions button { position: absolute; top: 0; font-family: Silkscreen; font-size: 18dp; height: 38dp; line-height: 38dp; border-width: 2dp; text-align: center; }
#forget-back { left: 0; width: 200dp; }
#forget-confirm { left: 224dp; width: 200dp; }

.account-screen .account-summary { height: 44dp; line-height: 32dp; font-size: 15dp; color: #fff13d; }
.account-state { float: right; padding-right: 8dp; }
.account-empty { padding: 44dp 24dp; color: #b4e6ff; }
.account-action { display: block; text-align: center; line-height: 40dp; border-width: 2dp; width: 336dp; height: 44dp; margin-top: 24dp; font-family: Silkscreen; font-size: 17dp; }
.account-form { width: 560dp; max-width: 100%; padding-top: 8dp; }
.account-form label { display: block; margin: 0 0 8dp 0; font-size: 14dp; color: #b4e6ff; }
.account-input { display: block; box-sizing: border-box; width: 100%; height: 42dp; padding: 8dp 12dp; margin: 0 0 20dp 0; font-family: Silkscreen; font-size: 17dp; color: #ffffff; background-color: #061a48; border: 2dp #75b2e4; }
.account-input:hover, .account-input.focused, .account-input:focus { border-color: #fff13d; }
.account-form-actions { height: 44dp; }
.account-form-actions button { display: inline-block; box-sizing: border-box; text-align: center; line-height: 36dp; border-width: 2dp; width: 244dp; height: 40dp; margin-right: 16dp; font-family: Silkscreen; font-size: 16dp; }
.account-help { margin-top: 16dp; font-size: 12dp; color: #b4e6ff; }
.account-error { margin-top: 16dp; font-size: 13dp; color: #fff13d; }
.account-catalog .list { position: relative; left: 0; top: 0; width: 100%; }
.account-catalog .list-pager { position: relative; top: auto; margin-top: 12dp; }
.account-none { display: none; padding-top: 140dp; text-align: center; color: #b4e6ff; }
#achievements-list.empty ~ .account-none { display: block; }
#achievements-list.empty .list-pager { display: none; }
#achievements-panel .list-actions .list-back { left: auto; right: 0; width: 24%; }
#achievements-panel .account-toggle { left: 0; width: 32%; }
#achievements-panel .account-signout { left: 36%; width: 32%; }
#achievements-panel .account-retry { left: 0; width: 32%; }
.text-keyboard { position: absolute; left: 24dp; top: 302dp; width: 904dp; padding: 10dp 0; z-index: 110; background-color: #1049c3; border: 2dp #75b2e4; }
.text-keyboard-heading { padding: 0 12dp 10dp; font-size: 12dp; color: #b4e6ff; }
.text-key { display: inline-block; box-sizing: border-box; width: 8.8%; height: 40dp; margin: 0.14%; padding: 0; text-align: center; font-family: Silkscreen; font-size: 14dp; }
.session-dialog { position: absolute; box-sizing: border-box; left: 0; top: 0; width: 100%; height: 100%; padding: 130dp 56dp; z-index: 120; background-color: #1049c3; }
.session-dialog-title { font-size: 24dp; color: #fff13d; margin-bottom: 24dp; }
.session-dialog-copy { font-size: 16dp; line-height: 28dp; max-width: 760dp; }
.session-dialog-actions { margin-top: 40dp; }
.session-dialog-actions button { display: inline-block; box-sizing: border-box; height: 48dp; padding: 0 18dp; margin-right: 20dp; border-width: 2dp; font-family: Silkscreen; font-size: 16dp; line-height: 44dp; text-align: center; }

.account-password-row { position: relative; }
.account-password-row .account-input { padding-right: 128dp; }
.account-reveal { box-sizing: border-box; position: absolute; right: 8dp; top: 6dp; width: 104dp; height: 30dp; line-height: 26dp; border-width: 2dp; text-align: center; font-family: Silkscreen; font-size: 13dp; }

/* A badge still downloading is nine dim pixels in a square, with a lit pair
 * that steps round the edge clockwise. A badge that we could not download is
 * the same pixels as an X, and we try again when the list opens next. Each
 * design puts .list-row-wait at the place of .list-row-icon. A cell is a
 * quarter of it, with an eighth between, in hard edges and design colours. */
.list-row-wait { display: none; }
.list-row.badge-loading .list-row-wait { display: block; }
.list-row-wait-cells { position: relative; width: 100%; height: 100%; }
.list-row-wait-cells div { position: absolute; width: 25%; height: 25%; background-color: #476eab; }
.list-row-wait-cells div:nth-child(3n+1) { left: 0; }
.list-row-wait-cells div:nth-child(3n+2) { left: 37.5%; }
.list-row-wait-cells div:nth-child(3n) { left: 75%; }
.list-row-wait-cells div:nth-child(-n+3) { top: 0; }
.list-row-wait-cells div:nth-child(n+4) { top: 37.5%; }
.list-row-wait-cells div:nth-child(n+7) { top: 75%; }
/* The edge in four pairs, clockwise from the top left, 1 2, 3 6, 9 8, 7 4.
 * Each pair is lit for a quarter of the turn. The turn starts half a step in,
 * so the first step comes 0.075 s after the list opens. A hold ends 0.1% before
 * the next step, because RmlUi treats keyframes closer than 0.01% as one. */
.list-row.badge-loading .list-row-wait-cells div:nth-child(1),
.list-row.badge-loading .list-row-wait-cells div:nth-child(2) { animation: 0.6s linear infinite badge-edge-1; }
.list-row.badge-loading .list-row-wait-cells div:nth-child(3),
.list-row.badge-loading .list-row-wait-cells div:nth-child(6) { animation: 0.6s linear infinite badge-edge-2; }
.list-row.badge-loading .list-row-wait-cells div:nth-child(9),
.list-row.badge-loading .list-row-wait-cells div:nth-child(8) { animation: 0.6s linear infinite badge-edge-3; }
.list-row.badge-loading .list-row-wait-cells div:nth-child(7),
.list-row.badge-loading .list-row-wait-cells div:nth-child(4) { animation: 0.6s linear infinite badge-edge-4; }
@keyframes badge-edge-1 {
   0% { background-color: #fff13d; } 12.4% { background-color: #fff13d; }
   12.5% { background-color: #476eab; } 87.4% { background-color: #476eab; }
   87.5% { background-color: #fff13d; } 100% { background-color: #fff13d; }
}
@keyframes badge-edge-2 {
   0% { background-color: #476eab; } 12.4% { background-color: #476eab; }
   12.5% { background-color: #fff13d; } 37.4% { background-color: #fff13d; }
   37.5% { background-color: #476eab; } 100% { background-color: #476eab; }
}
@keyframes badge-edge-3 {
   0% { background-color: #476eab; } 37.4% { background-color: #476eab; }
   37.5% { background-color: #fff13d; } 62.4% { background-color: #fff13d; }
   62.5% { background-color: #476eab; } 100% { background-color: #476eab; }
}
@keyframes badge-edge-4 {
   0% { background-color: #476eab; } 62.4% { background-color: #476eab; }
   62.5% { background-color: #fff13d; } 87.4% { background-color: #fff13d; }
   87.5% { background-color: #476eab; } 100% { background-color: #476eab; }
}
/* SHOW is inside the password field, so for the arrow keys neither is next to
 * the other until we declare it here. */
#achievement-password { nav-right: #achievements-password-visibility; }
#achievements-password-visibility { nav-left: #achievement-password; }
