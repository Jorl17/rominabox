<img id="controller-image" src="controller-megadrive6.png"/>
<button id="control-up" class="control-callout" style="left:16dp;top:68dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:122dp;"/><div class="control-leader vertical" style="left:320dp;top:24dp;height:66dp;"/><div id="control-hit-up" class="control-hit" style="left:299dp;top:69dp;"/></button>
<button id="control-down" class="control-callout" style="left:16dp;top:188dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:122dp;"/><div class="control-leader vertical" style="left:320dp;top:20dp;height:4dp;"/><div id="control-hit-down" class="control-hit" style="left:299dp;top:-1dp;"/></button>
<button id="control-left" class="control-callout" style="left:16dp;top:128dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:97dp;"/><div class="control-leader vertical" style="left:295dp;top:24dp;height:31dp;"/><div id="control-hit-left" class="control-hit" style="left:274dp;top:34dp;"/></button>
<button id="control-right" class="control-callout" style="left:16dp;top:248dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:147dp;"/><div class="control-leader vertical" style="left:345dp;top:-65dp;height:89dp;"/><div id="control-hit-right" class="control-hit" style="left:324dp;top:-86dp;"/></button>
<button id="control-y" class="control-callout" style="left:744dp;top:308dp;"><div id="control-label-y" class="control-label">A</div><div class="control-assignment"><span id="control-binding-y">z</span></div><div class="control-leader horizontal" style="left:-175dp;top:24dp;width:173dp;"/><div class="control-leader vertical" style="left:-175dp;top:-75dp;height:99dp;"/><div id="control-hit-y" class="control-hit" style="left:-196dp;top:-96dp;"/></button>
<button id="control-b" class="control-callout" style="left:744dp;top:248dp;"><div id="control-label-b" class="control-label">B</div><div class="control-assignment"><span id="control-binding-b">x</span></div><div class="control-leader horizontal" style="left:-129dp;top:24dp;width:127dp;"/><div class="control-leader vertical" style="left:-129dp;top:-42dp;height:66dp;"/><div id="control-hit-b" class="control-hit" style="left:-150dp;top:-63dp;"/></button>
<button id="control-a" class="control-callout" style="left:744dp;top:188dp;"><div id="control-label-a" class="control-label">C</div><div class="control-assignment"><span id="control-binding-a">c</span></div><div class="control-leader horizontal" style="left:-80dp;top:24dp;width:78dp;"/><div class="control-leader vertical" style="left:-80dp;top:0dp;height:24dp;"/><div id="control-hit-a" class="control-hit" style="left:-101dp;top:-21dp;"/></button>
<button id="control-start" class="control-callout" style="left:16dp;top:308dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:255dp;"/><div class="control-leader vertical" style="left:453dp;top:-135dp;height:159dp;"/><div id="control-hit-start" class="control-hit" style="left:432dp;top:-156dp;"/></button>
<button id="control-l" class="control-callout" style="left:744dp;top:128dp;"><div id="control-label-l" class="control-label">X</div><div class="control-assignment"><span id="control-binding-l">a</span></div><div class="control-leader horizontal" style="left:-193dp;top:24dp;width:191dp;"/><div class="control-leader vertical" style="left:-193dp;top:24dp;height:22dp;"/><div id="control-hit-l" class="control-hit" style="left:-214dp;top:25dp;"/></button>
<button id="control-x" class="control-callout" style="left:744dp;top:68dp;"><div id="control-label-x" class="control-label">Y</div><div class="control-assignment"><span id="control-binding-x">s</span></div><div class="control-leader horizontal" style="left:-151dp;top:24dp;width:149dp;"/><div class="control-leader vertical" style="left:-151dp;top:24dp;height:60dp;"/><div id="control-hit-x" class="control-hit" style="left:-172dp;top:63dp;"/></button>
<button id="control-r" class="control-callout" style="left:744dp;top:8dp;"><div id="control-label-r" class="control-label">Z</div><div class="control-assignment"><span id="control-binding-r">d</span></div><div class="control-leader horizontal" style="left:-107dp;top:24dp;width:105dp;"/><div class="control-leader vertical" style="left:-107dp;top:24dp;height:108dp;"/><div id="control-hit-r" class="control-hit" style="left:-128dp;top:111dp;"/></button>
<button id="control-select" class="control-callout" style="left:16dp;top:8dp;"><div id="control-label-select" class="control-label">Mode</div><div class="control-assignment"><span id="control-binding-select">rshift</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:255dp;"/><div class="control-leader vertical" style="left:453dp;top:24dp;height:74dp;"/><div id="control-hit-select" class="control-hit" style="left:432dp;top:77dp;"/></button>