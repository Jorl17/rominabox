<rml><head><title>ROM-in-a-Box</title><link type="text/rcss" href="parts/background.rcss"/><link type="text/rcss" href="parts/navigation.rcss"/><link type="text/rcss" href="parts/slider.rcss"/><link type="text/rcss" href="parts/toggle.rcss"/><link type="text/rcss" href="menu.rcss"/></head><body id="body">
<div id="screen"><div id="splash"><img id="splash-logo" src="splash-logo.png"/></div><div id="notice" class="notice">PRESS ESC TO PAUSE</div><div id="heading">GAME PAUSED</div><div id="pause-panel"><div id="slots"><button id="slot-1" class="slot empty selected"><div id="slot-label-1" class="slot-label">SLOT 1</div><div class="slot-frame"><div class="slot-picture" data-game-shaped><div id="slot-image-1" class="slot-image"/></div></div><div id="slot-state-1" class="slot-state">EMPTY</div></button>
<button id="slot-2" class="slot empty "><div id="slot-label-2" class="slot-label">SLOT 2</div><div class="slot-frame"><div class="slot-picture" data-game-shaped><div id="slot-image-2" class="slot-image"/></div></div><div id="slot-state-2" class="slot-state">EMPTY</div></button>
<button id="slot-3" class="slot empty "><div id="slot-label-3" class="slot-label">SLOT 3</div><div class="slot-frame"><div class="slot-picture" data-game-shaped><div id="slot-image-3" class="slot-image"/></div></div><div id="slot-state-3" class="slot-state">EMPTY</div></button>
<button id="slot-4" class="slot empty "><div id="slot-label-4" class="slot-label">SLOT 4</div><div class="slot-frame"><div class="slot-picture" data-game-shaped><div id="slot-image-4" class="slot-image"/></div></div><div id="slot-state-4" class="slot-state">EMPTY</div></button>
<button id="slot-5" class="slot empty "><div id="slot-label-5" class="slot-label">SLOT 5</div><div class="slot-frame"><div class="slot-picture" data-game-shaped><div id="slot-image-5" class="slot-image"/></div></div><div id="slot-state-5" class="slot-state">EMPTY</div></button>
<button id="slot-6" class="slot empty "><div id="slot-label-6" class="slot-label">SLOT 6</div><div class="slot-frame"><div class="slot-picture" data-game-shaped><div id="slot-image-6" class="slot-image"/></div></div><div id="slot-state-6" class="slot-state">EMPTY</div></button></div>
<div id="actions"><button class="menu-action" id="resume" autofocus="autofocus">CONTINUE</button><button class="menu-action" id="save">SAVE · SLOT <span data-fact="chosen-slot">1</span></button><button id="load" class="menu-action disabled" disabled="disabled">LOAD · SLOT <span data-fact="chosen-slot">1</span></button><button class="menu-action" id="options">OPTIONS</button><button class="menu-action" id="quit">QUIT</button></div>
<div id="status">CHOOSE A SLOT</div></div><div id="controls-panel" class="screen-panel" style="display:none;">
<div id="controls-device" class="control-picker">
<div id="controls-device-label" class="control-picker-label">CONTROLLER</div>
<button id="controls-device-current" class="control-picker-current">PLAYSTATION · DUALSHOCK</button>
<div id="controls-device-list" class="control-picker-list" style="display:none;">
<button id="controls-device-option-ps1" class="control-picker-option selected">PLAYSTATION · DUALSHOCK</button>
<button id="controls-device-option-ps1-analog" class="control-picker-option">PLAYSTATION · ANALOGUE</button>
</div>
</div>
<div id="controller-scene"><img id="controller-image" src="controller-ps1.png"/>
<div class="control-leader vertical" style="left:402dp;top:228dp;height:78dp;"/>
<button id="control-group-l_stick" class="control-group" style="left:236dp;top:306dp;">
