</div><div id="binds-pager" class="list-pager" style="display:none;"><button id="binds-prev" class="menu-action list-pager-prev">&lt;</button><div id="binds-page-count" class="list-pager-count"></div><button id="binds-next" class="menu-action list-pager-next">&gt;</button></div></div><div id="controls-actions"><button class="menu-action" id="controls-back">BACK</button><button class="menu-action" id="controls-reset">RESET DEFAULTS</button><button class="menu-action" id="controls-cancel" style="display:none;">CANCEL</button></div><div id="controls-status">CHOOSE A CONTROL</div></div><div id="unlock-row" style="display:none;"><div id="unlock"><img id="unlock-badge"/><div id="unlock-words"><div id="unlock-kicker">ACHIEVEMENT UNLOCKED</div><div id="unlock-title"></div><div id="unlock-detail"></div></div></div></div><div id="options-panel" class="screen-panel" style="display:none;"><div id="volume-control"><div id="volume-level" class="slider"><div id="volume-level-readout" class="slider-readout"></div><div class="slider-track"><div id="volume-level-fill" class="slider-fill"></div><div id="volume-level-thumb" class="slider-thumb"></div></div></div>
<button id="volume-down" class="menu-action volume-arrow arrow-down">&lt;</button><button id="volume-up" class="menu-action volume-arrow arrow-up">&gt;</button><div id="volume-low" class="volume-end">LOW</div><div id="volume-high" class="volume-end">HIGH</div><div class="volume-name">VOLUME</div></div><div id="options-entries"><button class="menu-action option-entry" id="controls"><span class="option-label">CONTROLS</span></button><button class="switch menu-action option-entry" id="background-play"><span class="option-label">PLAY IN BACKGROUND <span id="background-play-state" class="setting-state"></span></span></button><button class="switch menu-action option-entry" id="rumble"><span class="option-label">RUMBLE <span id="rumble-state" class="setting-state"></span></span></button></div><button class="menu-action options-back" id="options-back">BACK</button></div><div id="footer"><span id="footer-hint">ESC  CONTINUE</span><span id="version">ROM-IN-A-BOX / @VERSION@</span></div></div></body></rml>
