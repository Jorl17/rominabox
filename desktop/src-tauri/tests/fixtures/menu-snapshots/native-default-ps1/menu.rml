<rml><head><title>ROM-in-a-Box</title><link type="text/rcss" href="parts/navigation.rcss"/><link type="text/rcss" href="parts/slider.rcss"/><link type="text/rcss" href="parts/toggle.rcss"/><link type="text/rcss" href="menu.rcss"/></head><body id="body">
<div id="screen"><div id="splash"><img id="splash-logo" src="splash-logo.png"/></div><div id="notice" class="notice">PRESS ESC TO PAUSE</div><div id="heading">GAME PAUSED</div><div id="pause-panel"><div id="slots"><button id="slot-1" class="slot empty selected"><div id="slot-label-1" class="slot-label">SLOT 1</div><div class="slot-picture"><div id="slot-image-1" class="slot-image"/></div><div id="slot-state-1" class="slot-state">EMPTY</div></button>
<button id="slot-2" class="slot empty "><div id="slot-label-2" class="slot-label">SLOT 2</div><div class="slot-picture"><div id="slot-image-2" class="slot-image"/></div><div id="slot-state-2" class="slot-state">EMPTY</div></button>
<button id="slot-3" class="slot empty "><div id="slot-label-3" class="slot-label">SLOT 3</div><div class="slot-picture"><div id="slot-image-3" class="slot-image"/></div><div id="slot-state-3" class="slot-state">EMPTY</div></button>
<button id="slot-4" class="slot empty "><div id="slot-label-4" class="slot-label">SLOT 4</div><div class="slot-picture"><div id="slot-image-4" class="slot-image"/></div><div id="slot-state-4" class="slot-state">EMPTY</div></button>
<button id="slot-5" class="slot empty "><div id="slot-label-5" class="slot-label">SLOT 5</div><div class="slot-picture"><div id="slot-image-5" class="slot-image"/></div><div id="slot-state-5" class="slot-state">EMPTY</div></button>
<button id="slot-6" class="slot empty "><div id="slot-label-6" class="slot-label">SLOT 6</div><div class="slot-picture"><div id="slot-image-6" class="slot-image"/></div><div id="slot-state-6" class="slot-state">EMPTY</div></button></div>
<div id="actions"><button class="menu-action" id="resume">CONTINUE</button><button class="menu-action" id="save">SAVE</button><button id="load" class="menu-action disabled" disabled="disabled">LOAD</button><button class="menu-action" id="options">OPTIONS</button><button class="menu-action" id="quit">QUIT</button></div>
<div id="status">CHOOSE A SLOT</div></div><div id="controls-panel" class="screen-panel" style="display:none;">
<div id="controls-device" class="control-picker">
<div id="controls-device-label" class="control-picker-label">CONTROLLER</div>
<button id="controls-device-current" class="control-picker-current">PLAYSTATION · DUALSHOCK</button>
<div id="controls-device-list" class="control-picker-list" style="display:none;">
<button id="controls-device-option-ps1" class="control-picker-option selected">PLAYSTATION · DUALSHOCK</button>
<button id="controls-device-option-ps1-analog" class="control-picker-option">PLAYSTATION · ANALOGUE</button>
</div>
</div>
<div id="controller-scene"><img id="controller-image" src="controller-ps1.png"/>
<button id="control-group-l_stick" class="control-group" style="left:236dp;top:306dp;">
<div class="control-label">L STICK</div>
<div id="control-group-binding-l_stick" class="control-assignment">t, g, v, b, 1</div><div class="control-leader vertical" style="left:167dp;top:-82dp;height:80dp;"/><div id="control-hit-l3" class="control-hit" style="left:146dp;top:-103dp;"/>
</button>

<button id="control-group-r_stick" class="control-group" style="left:488dp;top:306dp;">
<div class="control-label">R STICK</div>
<div id="control-group-binding-r_stick" class="control-assignment">i, k, j, l, 2</div><div class="control-leader vertical" style="left:57dp;top:-82dp;height:80dp;"/><div id="control-hit-r3" class="control-hit" style="left:36dp;top:-103dp;"/>
</button>

<button id="control-l" class="control-callout" style="left:16dp;top:0dp;"><div id="control-label-l" class="control-label">L1</div><div class="control-assignment"><span id="control-binding-l">d</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:85dp;"/><div class="control-leader vertical" style="left:283dp;top:24dp;height:20dp;"/><div id="control-hit-l" class="control-hit" style="left:262dp;top:23dp;"/></button>
<button id="control-l2" class="control-callout" style="left:16dp;top:54dp;"><div id="control-label-l2" class="control-label">L2</div><div class="control-assignment"><span id="control-binding-l2">w</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:129dp;"/><div class="control-leader vertical" style="left:327dp;top:-10dp;height:34dp;"/><div id="control-hit-l2" class="control-hit" style="left:306dp;top:-31dp;"/></button>
<button id="control-up" class="control-callout" style="left:16dp;top:108dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:107dp;"/><div class="control-leader vertical" style="left:305dp;top:10dp;height:14dp;"/><div id="control-hit-up" class="control-hit" style="left:284dp;top:-11dp;"/></button>
<button id="control-left" class="control-callout" style="left:16dp;top:162dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:80dp;"/><div class="control-leader vertical" style="left:278dp;top:-17dp;height:41dp;"/><div id="control-hit-left" class="control-hit" style="left:257dp;top:-38dp;"/></button>
<button id="control-right" class="control-callout" style="left:16dp;top:216dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:134dp;"/><div class="control-leader vertical" style="left:332dp;top:-71dp;height:95dp;"/><div id="control-hit-right" class="control-hit" style="left:311dp;top:-92dp;"/></button>
<button id="control-down" class="control-callout" style="left:16dp;top:270dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:107dp;"/><div class="control-leader vertical" style="left:305dp;top:-98dp;height:122dp;"/><div id="control-hit-down" class="control-hit" style="left:284dp;top:-119dp;"/></button>
<button id="control-select" class="control-callout" style="left:16dp;top:324dp;"><div id="control-label-select" class="control-label">Select</div><div class="control-assignment"><span id="control-binding-select">rshift</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:214dp;"/><div class="control-leader vertical" style="left:412dp;top:-170dp;height:194dp;"/><div id="control-hit-select" class="control-hit" style="left:391dp;top:-191dp;"/></button>
<button id="control-r" class="control-callout" style="left:744dp;top:0dp;"><div id="control-label-r" class="control-label">R1</div><div class="control-assignment"><span id="control-binding-r">c</span></div><div class="control-leader horizontal" style="left:-94dp;top:24dp;width:92dp;"/><div class="control-leader vertical" style="left:-94dp;top:24dp;height:20dp;"/><div id="control-hit-r" class="control-hit" style="left:-115dp;top:23dp;"/></button>
<button id="control-r2" class="control-callout" style="left:744dp;top:54dp;"><div id="control-label-r2" class="control-label">R2</div><div class="control-assignment"><span id="control-binding-r2">e</span></div><div class="control-leader horizontal" style="left:-138dp;top:24dp;width:136dp;"/><div class="control-leader vertical" style="left:-138dp;top:-10dp;height:34dp;"/><div id="control-hit-r2" class="control-hit" style="left:-159dp;top:-31dp;"/></button>
<button id="control-x" class="control-callout" style="left:744dp;top:108dp;"><div id="control-label-x" class="control-label">Triangle</div><div class="control-assignment"><span id="control-binding-x">s</span></div><div class="control-leader horizontal" style="left:-114dp;top:24dp;width:112dp;"/><div class="control-leader vertical" style="left:-114dp;top:0dp;height:24dp;"/><div id="control-hit-x" class="control-hit" style="left:-135dp;top:-21dp;"/></button>
<button id="control-a" class="control-callout" style="left:744dp;top:162dp;"><div id="control-label-a" class="control-label">Circle</div><div class="control-assignment"><span id="control-binding-a">x</span></div><div class="control-leader horizontal" style="left:-76dp;top:24dp;width:74dp;"/><div class="control-leader vertical" style="left:-76dp;top:-16dp;height:40dp;"/><div id="control-hit-a" class="control-hit" style="left:-97dp;top:-37dp;"/></button>
<button id="control-y" class="control-callout" style="left:744dp;top:216dp;"><div id="control-label-y" class="control-label">Square</div><div class="control-assignment"><span id="control-binding-y">a</span></div><div class="control-leader horizontal" style="left:-152dp;top:24dp;width:150dp;"/><div class="control-leader vertical" style="left:-152dp;top:-70dp;height:94dp;"/><div id="control-hit-y" class="control-hit" style="left:-173dp;top:-91dp;"/></button>
<button id="control-b" class="control-callout" style="left:744dp;top:270dp;"><div id="control-label-b" class="control-label">Cross</div><div class="control-assignment"><span id="control-binding-b">z</span></div><div class="control-leader horizontal" style="left:-114dp;top:24dp;width:112dp;"/><div class="control-leader vertical" style="left:-114dp;top:-86dp;height:110dp;"/><div id="control-hit-b" class="control-hit" style="left:-135dp;top:-107dp;"/></button>
<button id="control-start" class="control-callout" style="left:744dp;top:324dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div class="control-leader horizontal" style="left:-226dp;top:24dp;width:224dp;"/><div class="control-leader vertical" style="left:-226dp;top:-170dp;height:194dp;"/><div id="control-hit-start" class="control-hit" style="left:-247dp;top:-191dp;"/></button></div><div id="control-binds" class="list" style="display:none;"><div id="binds-page-1" class="list-page"><button id="bind-1" class="list-row "><div id="bind-1-title" class="list-row-title"></div><div id="bind-1-detail" class="list-row-detail"></div><div id="bind-1-state" class="list-row-state"></div></button>
<button id="bind-2" class="list-row "><div id="bind-2-title" class="list-row-title"></div><div id="bind-2-detail" class="list-row-detail"></div><div id="bind-2-state" class="list-row-state"></div></button>
<button id="bind-3" class="list-row "><div id="bind-3-title" class="list-row-title"></div><div id="bind-3-detail" class="list-row-detail"></div><div id="bind-3-state" class="list-row-state"></div></button>
<button id="bind-4" class="list-row "><div id="bind-4-title" class="list-row-title"></div><div id="bind-4-detail" class="list-row-detail"></div><div id="bind-4-state" class="list-row-state"></div></button>
<button id="bind-5" class="list-row "><div id="bind-5-title" class="list-row-title"></div><div id="bind-5-detail" class="list-row-detail"></div><div id="bind-5-state" class="list-row-state"></div></button>
</div><div id="binds-page-2" class="list-page" style="display:none;"><button id="bind-6" class="list-row "><div id="bind-6-title" class="list-row-title"></div><div id="bind-6-detail" class="list-row-detail"></div><div id="bind-6-state" class="list-row-state"></div></button>
<button id="bind-7" class="list-row "><div id="bind-7-title" class="list-row-title"></div><div id="bind-7-detail" class="list-row-detail"></div><div id="bind-7-state" class="list-row-state"></div></button>
<button id="bind-8" class="list-row "><div id="bind-8-title" class="list-row-title"></div><div id="bind-8-detail" class="list-row-detail"></div><div id="bind-8-state" class="list-row-state"></div></button>
<button id="bind-9" class="list-row "><div id="bind-9-title" class="list-row-title"></div><div id="bind-9-detail" class="list-row-detail"></div><div id="bind-9-state" class="list-row-state"></div></button>
<button id="bind-10" class="list-row "><div id="bind-10-title" class="list-row-title"></div><div id="bind-10-detail" class="list-row-detail"></div><div id="bind-10-state" class="list-row-state"></div></button>
</div><div id="binds-page-3" class="list-page" style="display:none;"><button id="bind-11" class="list-row "><div id="bind-11-title" class="list-row-title"></div><div id="bind-11-detail" class="list-row-detail"></div><div id="bind-11-state" class="list-row-state"></div></button>
<button id="bind-12" class="list-row "><div id="bind-12-title" class="list-row-title"></div><div id="bind-12-detail" class="list-row-detail"></div><div id="bind-12-state" class="list-row-state"></div></button>
<button id="bind-13" class="list-row "><div id="bind-13-title" class="list-row-title"></div><div id="bind-13-detail" class="list-row-detail"></div><div id="bind-13-state" class="list-row-state"></div></button>
<button id="bind-14" class="list-row "><div id="bind-14-title" class="list-row-title"></div><div id="bind-14-detail" class="list-row-detail"></div><div id="bind-14-state" class="list-row-state"></div></button>
<button id="bind-15" class="list-row "><div id="bind-15-title" class="list-row-title"></div><div id="bind-15-detail" class="list-row-detail"></div><div id="bind-15-state" class="list-row-state"></div></button>
</div><div id="binds-page-4" class="list-page" style="display:none;"><button id="bind-16" class="list-row "><div id="bind-16-title" class="list-row-title"></div><div id="bind-16-detail" class="list-row-detail"></div><div id="bind-16-state" class="list-row-state"></div></button>
<button id="bind-17" class="list-row "><div id="bind-17-title" class="list-row-title"></div><div id="bind-17-detail" class="list-row-detail"></div><div id="bind-17-state" class="list-row-state"></div></button>
<button id="bind-18" class="list-row "><div id="bind-18-title" class="list-row-title"></div><div id="bind-18-detail" class="list-row-detail"></div><div id="bind-18-state" class="list-row-state"></div></button>
<button id="bind-19" class="list-row "><div id="bind-19-title" class="list-row-title"></div><div id="bind-19-detail" class="list-row-detail"></div><div id="bind-19-state" class="list-row-state"></div></button>
<button id="bind-20" class="list-row "><div id="bind-20-title" class="list-row-title"></div><div id="bind-20-detail" class="list-row-detail"></div><div id="bind-20-state" class="list-row-state"></div></button>
</div><div id="binds-pager" class="list-pager"><button id="binds-prev" class="menu-action list-pager-prev disabled">&lt;</button><div id="binds-page-count" class="list-pager-count">1/4</div><button id="binds-next" class="menu-action list-pager-next">&gt;</button></div></div><div id="controls-actions"><button class="menu-action" id="controls-back">BACK</button><button class="menu-action" id="controls-reset">RESET DEFAULTS</button><button class="menu-action" id="controls-cancel" style="display:none;">CANCEL</button></div><div id="controls-status">SELECT A BUTTON</div></div><div id="unlock-row" style="display:none;"><div id="unlock"><img id="unlock-badge"/><div id="unlock-words"><div id="unlock-kicker">ACHIEVEMENT UNLOCKED</div><div id="unlock-title"></div><div id="unlock-detail"></div></div></div></div><div id="options-panel" class="screen-panel" style="display:none;"><div id="volume-control"><div id="volume-level" class="slider"><div id="volume-level-readout" class="slider-readout"></div><div class="slider-track"><div id="volume-level-fill" class="slider-fill"></div><div id="volume-level-thumb" class="slider-thumb"></div></div></div>
<button id="volume-down" class="menu-action volume-arrow arrow-down">&lt;</button><button id="volume-up" class="menu-action volume-arrow arrow-up">&gt;</button><div id="volume-low" class="volume-end">LOW</div><div id="volume-high" class="volume-end">HIGH</div><div class="volume-name">VOLUME</div></div><div id="options-entries"><button class="menu-action option-entry" id="controls" style="top: 0dp;">CONTROLS</button></div><button class="menu-action options-back" id="options-back">BACK</button></div><div id="footer"><span id="footer-hint">ESC CONTINUE</span><span id="version">ROM-IN-A-BOX / @VERSION@</span></div></div></body></rml>
