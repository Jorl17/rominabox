<div class="control-label">L STICK</div>
<div id="control-group-binding-l_stick" class="control-assignment">t, g, v, b, 1</div><div id="control-hit-l3" class="control-hit" style="left:146dp;top:-103dp;"/>
</button>

<div class="control-leader vertical" style="left:547dp;top:226dp;height:80dp;"/>
