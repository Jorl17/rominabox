<img id="controller-image" src="controller-ps1.png"/>
<button id="control-group-l_stick" class="control-group" style="left:236dp;top:306dp;">
<div class="control-label">L STICK</div>
<div id="control-group-binding-l_stick" class="control-assignment">t, g, v, b, 1</div><div class="control-leader vertical" style="left:167dp;top:-82dp;height:80dp;"/><div class="control-leader horizontal" style="left:116dp;top:-2dp;width:51dp;"/><div id="control-hit-l3" class="control-hit" style="left:146dp;top:-103dp;"/>
</button>

<button id="control-group-r_stick" class="control-group" style="left:488dp;top:306dp;">
<div class="control-label">R STICK</div>
<div id="control-group-binding-r_stick" class="control-assignment">i, k, j, l, 2</div><div class="control-leader vertical" style="left:57dp;top:-82dp;height:80dp;"/><div class="control-leader horizontal" style="left:57dp;top:-2dp;width:59dp;"/><div id="control-hit-r3" class="control-hit" style="left:36dp;top:-103dp;"/>
</button>

<button id="control-l" class="control-callout" style="left:16dp;top:0dp;"><div id="control-label-l" class="control-label">L1</div><div class="control-assignment"><span id="control-binding-l">d</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:85dp;"/><div class="control-leader vertical" style="left:283dp;top:24dp;height:20dp;"/><div id="control-hit-l" class="control-hit" style="left:262dp;top:23dp;"/></button>
<button id="control-l2" class="control-callout" style="left:16dp;top:54dp;"><div id="control-label-l2" class="control-label">L2</div><div class="control-assignment"><span id="control-binding-l2">w</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:129dp;"/><div class="control-leader vertical" style="left:327dp;top:-10dp;height:34dp;"/><div id="control-hit-l2" class="control-hit" style="left:306dp;top:-31dp;"/></button>
<button id="control-up" class="control-callout" style="left:16dp;top:108dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:107dp;"/><div class="control-leader vertical" style="left:305dp;top:10dp;height:14dp;"/><div id="control-hit-up" class="control-hit" style="left:284dp;top:-11dp;"/></button>
<button id="control-left" class="control-callout" style="left:16dp;top:162dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:80dp;"/><div class="control-leader vertical" style="left:278dp;top:-17dp;height:41dp;"/><div id="control-hit-left" class="control-hit" style="left:257dp;top:-38dp;"/></button>
<button id="control-right" class="control-callout" style="left:16dp;top:216dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:134dp;"/><div class="control-leader vertical" style="left:332dp;top:-71dp;height:95dp;"/><div id="control-hit-right" class="control-hit" style="left:311dp;top:-92dp;"/></button>
<button id="control-down" class="control-callout" style="left:16dp;top:270dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:107dp;"/><div class="control-leader vertical" style="left:305dp;top:-98dp;height:122dp;"/><div id="control-hit-down" class="control-hit" style="left:284dp;top:-119dp;"/></button>
<button id="control-select" class="control-callout" style="left:16dp;top:324dp;"><div id="control-label-select" class="control-label">Select</div><div class="control-assignment"><span id="control-binding-select">rshift</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:214dp;"/><div class="control-leader vertical" style="left:412dp;top:-170dp;height:194dp;"/><div id="control-hit-select" class="control-hit" style="left:391dp;top:-191dp;"/></button>
<button id="control-r" class="control-callout" style="left:744dp;top:0dp;"><div id="control-label-r" class="control-label">R1</div><div class="control-assignment"><span id="control-binding-r">c</span></div><div class="control-leader horizontal" style="left:-94dp;top:24dp;width:92dp;"/><div class="control-leader vertical" style="left:-94dp;top:24dp;height:20dp;"/><div id="control-hit-r" class="control-hit" style="left:-115dp;top:23dp;"/></button>
<button id="control-r2" class="control-callout" style="left:744dp;top:54dp;"><div id="control-label-r2" class="control-label">R2</div><div class="control-assignment"><span id="control-binding-r2">e</span></div><div class="control-leader horizontal" style="left:-138dp;top:24dp;width:136dp;"/><div class="control-leader vertical" style="left:-138dp;top:-10dp;height:34dp;"/><div id="control-hit-r2" class="control-hit" style="left:-159dp;top:-31dp;"/></button>
<button id="control-x" class="control-callout" style="left:744dp;top:108dp;"><div id="control-label-x" class="control-label">Triangle</div><div class="control-assignment"><span id="control-binding-x">s</span></div><div class="control-leader horizontal" style="left:-114dp;top:24dp;width:112dp;"/><div class="control-leader vertical" style="left:-114dp;top:0dp;height:24dp;"/><div id="control-hit-x" class="control-hit" style="left:-135dp;top:-21dp;"/></button>
<button id="control-a" class="control-callout" style="left:744dp;top:162dp;"><div id="control-label-a" class="control-label">Circle</div><div class="control-assignment"><span id="control-binding-a">x</span></div><div class="control-leader horizontal" style="left:-76dp;top:24dp;width:74dp;"/><div class="control-leader vertical" style="left:-76dp;top:-16dp;height:40dp;"/><div id="control-hit-a" class="control-hit" style="left:-97dp;top:-37dp;"/></button>
<button id="control-y" class="control-callout" style="left:744dp;top:216dp;"><div id="control-label-y" class="control-label">Square</div><div class="control-assignment"><span id="control-binding-y">a</span></div><div class="control-leader horizontal" style="left:-152dp;top:24dp;width:150dp;"/><div class="control-leader vertical" style="left:-152dp;top:-70dp;height:94dp;"/><div id="control-hit-y" class="control-hit" style="left:-173dp;top:-91dp;"/></button>
<button id="control-b" class="control-callout" style="left:744dp;top:270dp;"><div id="control-label-b" class="control-label">Cross</div><div class="control-assignment"><span id="control-binding-b">z</span></div><div class="control-leader horizontal" style="left:-114dp;top:24dp;width:112dp;"/><div class="control-leader vertical" style="left:-114dp;top:-86dp;height:110dp;"/><div id="control-hit-b" class="control-hit" style="left:-135dp;top:-107dp;"/></button>
<button id="control-start" class="control-callout" style="left:744dp;top:324dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div class="control-leader horizontal" style="left:-226dp;top:24dp;width:224dp;"/><div class="control-leader vertical" style="left:-226dp;top:-170dp;height:194dp;"/><div id="control-hit-start" class="control-hit" style="left:-247dp;top:-191dp;"/></button>