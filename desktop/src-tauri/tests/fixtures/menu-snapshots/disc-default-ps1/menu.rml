<rml><head><title>ROM-in-a-Box</title><link type="text/rcss" href="parts/navigation.rcss"/><link type="text/rcss" href="parts/slider.rcss"/><link type="text/rcss" href="parts/toggle.rcss"/><link type="text/rcss" href="menu.rcss"/></head><body id="body">
<div id="screen"><div id="spine"></div><div id="splash"><img id="splash-logo" src="splash-logo.png"/></div><div id="notice" class="notice">PRESS ESC TO PAUSE</div><div id="heading">MEMORY CARD</div><div id="pause-panel"><div id="slots"><button id="slot-1" class="slot empty selected"><div id="slot-label-1" class="slot-label">SLOT 1</div><div class="slot-picture"><div id="slot-image-1" class="slot-image"/></div><div id="slot-state-1" class="slot-state">EMPTY</div></button>
<button id="slot-2" class="slot empty "><div id="slot-label-2" class="slot-label">SLOT 2</div><div class="slot-picture"><div id="slot-image-2" class="slot-image"/></div><div id="slot-state-2" class="slot-state">EMPTY</div></button>
<button id="slot-3" class="slot empty "><div id="slot-label-3" class="slot-label">SLOT 3</div><div class="slot-picture"><div id="slot-image-3" class="slot-image"/></div><div id="slot-state-3" class="slot-state">EMPTY</div></button>
<button id="slot-4" class="slot empty "><div id="slot-label-4" class="slot-label">SLOT 4</div><div class="slot-picture"><div id="slot-image-4" class="slot-image"/></div><div id="slot-state-4" class="slot-state">EMPTY</div></button>
<button id="slot-5" class="slot empty "><div id="slot-label-5" class="slot-label">SLOT 5</div><div class="slot-picture"><div id="slot-image-5" class="slot-image"/></div><div id="slot-state-5" class="slot-state">EMPTY</div></button>
<button id="slot-6" class="slot empty "><div id="slot-label-6" class="slot-label">SLOT 6</div><div class="slot-picture"><div id="slot-image-6" class="slot-image"/></div><div id="slot-state-6" class="slot-state">EMPTY</div></button></div>
<div id="actions"><button class="menu-action" id="resume">CONTINUE</button><button class="menu-action" id="save">SAVE</button><button id="load" class="menu-action disabled" disabled="disabled">LOAD</button><button class="menu-action" id="disc">DISC</button><button class="menu-action" id="options">OPTIONS</button><button class="menu-action" id="quit">QUIT</button></div>
<div id="status">CHOOSE A BLOCK</div></div><div id="controls-panel" class="screen-panel" style="display:none;">
<div id="controls-device" class="control-picker">
<div id="controls-device-label" class="control-picker-label">CONTROLLER</div>
<button id="controls-device-current" class="control-picker-current">PLAYSTATION · DUALSHOCK</button>
<div id="controls-device-list" class="control-picker-list" style="display:none;">
<button id="controls-device-option-ps1" class="control-picker-option selected">PLAYSTATION · DUALSHOCK</button>
<button id="controls-device-option-ps1-analog" class="control-picker-option">PLAYSTATION · ANALOGUE</button>
</div>
</div>
<div id="controller-scene"><img id="controller-image" src="controller-ps1.png"/>
<div class="control-leader vertical" style="left:405dp;top:226dp;height:102dp;"/>
<button id="control-group-l_stick" class="control-group" style="left:264dp;top:328dp;">
<div class="control-label">L STICK</div>
<div id="control-group-binding-l_stick" class="control-assignment">t, g, v, b, 1</div><div id="control-hit-l3" class="control-hit" style="left:125dp;top:-118dp;"/>
</button>

<div class="control-leader vertical" style="left:547dp;top:226dp;height:102dp;"/>
<button id="control-group-r_stick" class="control-group" style="left:486dp;top:328dp;">
<div class="control-label">R STICK</div>
<div id="control-group-binding-r_stick" class="control-assignment">i, k, j, l, 2</div><div id="control-hit-r3" class="control-hit" style="left:45dp;top:-118dp;"/>
</button>

<div class="control-leader horizontal" style="left:206dp;top:18dp;width:95dp;"/>
<div class="control-leader vertical" style="left:301dp;top:18dp;height:28dp;"/>
<button id="control-l" class="control-callout" style="left:16dp;top:0dp;"><div id="control-label-l" class="control-label">L1</div><div class="control-assignment"><span id="control-binding-l">d</span></div><div id="control-hit-l" class="control-hit" style="left:269dp;top:30dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:72dp;width:139dp;"/>
<div class="control-leader vertical" style="left:345dp;top:46dp;height:26dp;"/>
<button id="control-l2" class="control-callout" style="left:16dp;top:54dp;"><div id="control-label-l2" class="control-label">L2</div><div class="control-assignment"><span id="control-binding-l2">w</span></div><div id="control-hit-l2" class="control-hit" style="left:313dp;top:-24dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:126dp;width:117dp;"/>
<div class="control-leader vertical" style="left:323dp;top:120dp;height:6dp;"/>
<button id="control-up" class="control-callout" style="left:16dp;top:108dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div id="control-hit-up" class="control-hit" style="left:291dp;top:-4dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:180dp;width:90dp;"/>
<div class="control-leader vertical" style="left:296dp;top:147dp;height:33dp;"/>
<button id="control-left" class="control-callout" style="left:16dp;top:162dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div id="control-hit-left" class="control-hit" style="left:264dp;top:-31dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:234dp;width:144dp;"/>
<div class="control-leader vertical" style="left:350dp;top:147dp;height:87dp;"/>
<button id="control-right" class="control-callout" style="left:16dp;top:216dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div id="control-hit-right" class="control-hit" style="left:318dp;top:-85dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:288dp;width:117dp;"/>
<div class="control-leader vertical" style="left:323dp;top:174dp;height:114dp;"/>
<button id="control-down" class="control-callout" style="left:16dp;top:270dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div id="control-hit-down" class="control-hit" style="left:291dp;top:-112dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:342dp;width:224dp;"/>
<div class="control-leader vertical" style="left:430dp;top:156dp;height:186dp;"/>
<button id="control-select" class="control-callout" style="left:16dp;top:324dp;"><div id="control-label-select" class="control-label">Select</div><div class="control-assignment"><span id="control-binding-select">rshift</span></div><div id="control-hit-select" class="control-hit" style="left:398dp;top:-184dp;"/></button>
<div class="control-leader horizontal" style="left:652dp;top:18dp;width:92dp;"/>
<div class="control-leader vertical" style="left:652dp;top:18dp;height:28dp;"/>
<button id="control-r" class="control-callout" style="left:744dp;top:0dp;"><div id="control-label-r" class="control-label">R1</div><div class="control-assignment"><span id="control-binding-r">c</span></div><div id="control-hit-r" class="control-hit" style="left:-108dp;top:30dp;"/></button>
<div class="control-leader horizontal" style="left:608dp;top:72dp;width:136dp;"/>
<div class="control-leader vertical" style="left:608dp;top:46dp;height:26dp;"/>
<button id="control-r2" class="control-callout" style="left:744dp;top:54dp;"><div id="control-label-r2" class="control-label">R2</div><div class="control-assignment"><span id="control-binding-r2">e</span></div><div id="control-hit-r2" class="control-hit" style="left:-152dp;top:-24dp;"/></button>
<div class="control-leader horizontal" style="left:632dp;top:126dp;width:112dp;"/>
<div class="control-leader vertical" style="left:632dp;top:110dp;height:16dp;"/>
<button id="control-x" class="control-callout" style="left:744dp;top:108dp;"><div id="control-label-x" class="control-label">Triangle</div><div class="control-assignment"><span id="control-binding-x">s</span></div><div id="control-hit-x" class="control-hit" style="left:-128dp;top:-14dp;"/></button>
<div class="control-leader horizontal" style="left:670dp;top:180dp;width:74dp;"/>
<div class="control-leader vertical" style="left:670dp;top:148dp;height:32dp;"/>
<button id="control-a" class="control-callout" style="left:744dp;top:162dp;"><div id="control-label-a" class="control-label">Circle</div><div class="control-assignment"><span id="control-binding-a">x</span></div><div id="control-hit-a" class="control-hit" style="left:-90dp;top:-30dp;"/></button>
<div class="control-leader horizontal" style="left:594dp;top:234dp;width:150dp;"/>
<div class="control-leader vertical" style="left:594dp;top:148dp;height:86dp;"/>
<button id="control-y" class="control-callout" style="left:744dp;top:216dp;"><div id="control-label-y" class="control-label">Square</div><div class="control-assignment"><span id="control-binding-y">a</span></div><div id="control-hit-y" class="control-hit" style="left:-166dp;top:-84dp;"/></button>
<div class="control-leader horizontal" style="left:632dp;top:288dp;width:112dp;"/>
<div class="control-leader vertical" style="left:632dp;top:186dp;height:102dp;"/>
<button id="control-b" class="control-callout" style="left:744dp;top:270dp;"><div id="control-label-b" class="control-label">Cross</div><div class="control-assignment"><span id="control-binding-b">z</span></div><div id="control-hit-b" class="control-hit" style="left:-128dp;top:-100dp;"/></button>
<div class="control-leader horizontal" style="left:520dp;top:342dp;width:224dp;"/>
<div class="control-leader vertical" style="left:520dp;top:156dp;height:186dp;"/>
<button id="control-start" class="control-callout" style="left:744dp;top:324dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div id="control-hit-start" class="control-hit" style="left:-240dp;top:-184dp;"/></button></div><div id="control-binds" class="list" style="display:none;"><div id="binds-page-1" class="list-page"><button id="bind-1" class="list-row "><div id="bind-1-title" class="list-row-title"></div><div id="bind-1-detail" class="list-row-detail"></div><div id="bind-1-state" class="list-row-state"></div></button>
<button id="bind-2" class="list-row "><div id="bind-2-title" class="list-row-title"></div><div id="bind-2-detail" class="list-row-detail"></div><div id="bind-2-state" class="list-row-state"></div></button>
<button id="bind-3" class="list-row "><div id="bind-3-title" class="list-row-title"></div><div id="bind-3-detail" class="list-row-detail"></div><div id="bind-3-state" class="list-row-state"></div></button>
<button id="bind-4" class="list-row "><div id="bind-4-title" class="list-row-title"></div><div id="bind-4-detail" class="list-row-detail"></div><div id="bind-4-state" class="list-row-state"></div></button>
<button id="bind-5" class="list-row "><div id="bind-5-title" class="list-row-title"></div><div id="bind-5-detail" class="list-row-detail"></div><div id="bind-5-state" class="list-row-state"></div></button>
</div><div id="binds-page-2" class="list-page" style="display:none;"><button id="bind-6" class="list-row "><div id="bind-6-title" class="list-row-title"></div><div id="bind-6-detail" class="list-row-detail"></div><div id="bind-6-state" class="list-row-state"></div></button>
<button id="bind-7" class="list-row "><div id="bind-7-title" class="list-row-title"></div><div id="bind-7-detail" class="list-row-detail"></div><div id="bind-7-state" class="list-row-state"></div></button>
<button id="bind-8" class="list-row "><div id="bind-8-title" class="list-row-title"></div><div id="bind-8-detail" class="list-row-detail"></div><div id="bind-8-state" class="list-row-state"></div></button>
<button id="bind-9" class="list-row "><div id="bind-9-title" class="list-row-title"></div><div id="bind-9-detail" class="list-row-detail"></div><div id="bind-9-state" class="list-row-state"></div></button>
<button id="bind-10" class="list-row "><div id="bind-10-title" class="list-row-title"></div><div id="bind-10-detail" class="list-row-detail"></div><div id="bind-10-state" class="list-row-state"></div></button>
</div><div id="binds-page-3" class="list-page" style="display:none;"><button id="bind-11" class="list-row "><div id="bind-11-title" class="list-row-title"></div><div id="bind-11-detail" class="list-row-detail"></div><div id="bind-11-state" class="list-row-state"></div></button>
<button id="bind-12" class="list-row "><div id="bind-12-title" class="list-row-title"></div><div id="bind-12-detail" class="list-row-detail"></div><div id="bind-12-state" class="list-row-state"></div></button>
<button id="bind-13" class="list-row "><div id="bind-13-title" class="list-row-title"></div><div id="bind-13-detail" class="list-row-detail"></div><div id="bind-13-state" class="list-row-state"></div></button>
<button id="bind-14" class="list-row "><div id="bind-14-title" class="list-row-title"></div><div id="bind-14-detail" class="list-row-detail"></div><div id="bind-14-state" class="list-row-state"></div></button>
<button id="bind-15" class="list-row "><div id="bind-15-title" class="list-row-title"></div><div id="bind-15-detail" class="list-row-detail"></div><div id="bind-15-state" class="list-row-state"></div></button>
</div><div id="binds-page-4" class="list-page" style="display:none;"><button id="bind-16" class="list-row "><div id="bind-16-title" class="list-row-title"></div><div id="bind-16-detail" class="list-row-detail"></div><div id="bind-16-state" class="list-row-state"></div></button>
<button id="bind-17" class="list-row "><div id="bind-17-title" class="list-row-title"></div><div id="bind-17-detail" class="list-row-detail"></div><div id="bind-17-state" class="list-row-state"></div></button>
<button id="bind-18" class="list-row "><div id="bind-18-title" class="list-row-title"></div><div id="bind-18-detail" class="list-row-detail"></div><div id="bind-18-state" class="list-row-state"></div></button>
<button id="bind-19" class="list-row "><div id="bind-19-title" class="list-row-title"></div><div id="bind-19-detail" class="list-row-detail"></div><div id="bind-19-state" class="list-row-state"></div></button>
<button id="bind-20" class="list-row "><div id="bind-20-title" class="list-row-title"></div><div id="bind-20-detail" class="list-row-detail"></div><div id="bind-20-state" class="list-row-state"></div></button>
</div><div id="binds-pager" class="list-pager"><button id="binds-prev" class="menu-action list-pager-prev disabled">&lt;</button><div id="binds-page-count" class="list-pager-count">1/4</div><button id="binds-next" class="menu-action list-pager-next">&gt;</button></div></div><div id="controls-actions"><button class="menu-action" id="controls-back">BACK</button><button class="menu-action" id="controls-reset">RESET DEFAULTS</button><button class="menu-action" id="controls-cancel" style="display:none;">CANCEL</button></div><div id="controls-status">SELECT A BUTTON</div></div><div id="options-panel" class="screen-panel" style="display:none;"><div id="volume-control"><div id="volume-level" class="slider"><div id="volume-level-readout" class="slider-readout"></div><div class="slider-track"><div id="volume-level-fill" class="slider-fill"></div><div id="volume-level-thumb" class="slider-thumb"></div></div></div>
<button id="volume-down" class="menu-action volume-arrow arrow-down">&lt;</button><button id="volume-up" class="menu-action volume-arrow arrow-up">&gt;</button><div id="volume-low" class="volume-end">LOW</div><div id="volume-high" class="volume-end">HIGH</div><div class="volume-name">VOLUME</div></div><div id="options-entries" class="menu-index"><button class="menu-action option-entry" id="controls" style="top: 0dp;">PAD</button></div><button class="menu-action options-back" id="options-back">BACK</button></div><div id="disc-panel" class="screen-panel" style="display:none;"><div id="disc-face"><div id="disc-hole"></div></div><button class="menu-action" id="disc-back">BACK</button></div><div id="unlock-row" style="display:none;"><div id="unlock"><img id="unlock-badge"/><div id="unlock-words"><div id="unlock-kicker">ACHIEVEMENT UNLOCKED</div><div id="unlock-title"></div><div id="unlock-detail"></div></div></div></div><div id="footer"><span id="footer-hint">ESC  CONTINUE</span></div></div></body></rml>
