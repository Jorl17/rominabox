<img id="controller-image" src="controller-megadrive.png"/>
<button id="control-up" class="control-callout" style="left:16dp;top:16dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:117dp;"/><div class="control-leader vertical" style="left:315dp;top:24dp;height:118dp;"/><div id="control-hit-up" class="control-hit" style="left:294dp;top:121dp;"/></button>
<button id="control-left" class="control-callout" style="left:16dp;top:100dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:96dp;"/><div class="control-leader vertical" style="left:294dp;top:24dp;height:55dp;"/><div id="control-hit-left" class="control-hit" style="left:273dp;top:58dp;"/></button>
<button id="control-right" class="control-callout" style="left:16dp;top:268dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:138dp;"/><div class="control-leader vertical" style="left:336dp;top:-89dp;height:113dp;"/><div id="control-hit-right" class="control-hit" style="left:315dp;top:-110dp;"/></button>
<button id="control-down" class="control-callout" style="left:16dp;top:184dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div class="control-leader horizontal" style="left:198dp;top:24dp;width:117dp;"/><div class="control-leader vertical" style="left:315dp;top:17dp;height:7dp;"/><div id="control-hit-down" class="control-hit" style="left:294dp;top:-4dp;"/></button>
<button id="control-y" class="control-callout" style="left:744dp;top:268dp;"><div id="control-label-y" class="control-label">A</div><div class="control-assignment"><span id="control-binding-y">z</span></div><div class="control-leader horizontal" style="left:-177dp;top:24dp;width:175dp;"/><div class="control-leader vertical" style="left:-177dp;top:-57dp;height:81dp;"/><div id="control-hit-y" class="control-hit" style="left:-198dp;top:-78dp;"/></button>
<button id="control-b" class="control-callout" style="left:744dp;top:184dp;"><div id="control-label-b" class="control-label">B</div><div class="control-assignment"><span id="control-binding-b">x</span></div><div class="control-leader horizontal" style="left:-123dp;top:24dp;width:121dp;"/><div class="control-leader vertical" style="left:-123dp;top:0dp;height:24dp;"/><div id="control-hit-b" class="control-hit" style="left:-144dp;top:-21dp;"/></button>
<button id="control-a" class="control-callout" style="left:744dp;top:100dp;"><div id="control-label-a" class="control-label">C</div><div class="control-assignment"><span id="control-binding-a">c</span></div><div class="control-leader horizontal" style="left:-68dp;top:24dp;width:66dp;"/><div class="control-leader vertical" style="left:-68dp;top:24dp;height:38dp;"/><div id="control-hit-a" class="control-hit" style="left:-89dp;top:41dp;"/></button>
<button id="control-start" class="control-callout" style="left:744dp;top:16dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div class="control-leader horizontal" style="left:-159dp;top:24dp;width:157dp;"/><div class="control-leader vertical" style="left:-159dp;top:24dp;height:69dp;"/><div id="control-hit-start" class="control-hit" style="left:-180dp;top:72dp;"/></button>