<img id="controller-image" src="controller-megadrive6.png"/>
<button id="control-up" class="control-callout" style="left:16dp;top:68dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:132dp;"/><div class="control-leader vertical" style="left:321dp;top:17dp;height:74dp;"/><div id="control-hit-up" class="control-hit" style="left:306dp;top:76dp;"/></button>
<button id="control-down" class="control-callout" style="left:16dp;top:188dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:132dp;"/><div class="control-leader vertical" style="left:321dp;top:17dp;height:4dp;"/><div id="control-hit-down" class="control-hit" style="left:306dp;top:6dp;"/></button>
<button id="control-left" class="control-callout" style="left:16dp;top:128dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:107dp;"/><div class="control-leader vertical" style="left:296dp;top:17dp;height:39dp;"/><div id="control-hit-left" class="control-hit" style="left:281dp;top:41dp;"/></button>
<button id="control-right" class="control-callout" style="left:16dp;top:248dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:157dp;"/><div class="control-leader vertical" style="left:346dp;top:-64dp;height:81dp;"/><div id="control-hit-right" class="control-hit" style="left:331dp;top:-79dp;"/></button>
<button id="control-y" class="control-callout" style="left:744dp;top:308dp;"><div id="control-label-y" class="control-label">A</div><div class="control-assignment"><span id="control-binding-y">z</span></div><div class="control-leader horizontal" style="left:-174dp;top:17dp;width:173dp;"/><div class="control-leader vertical" style="left:-174dp;top:-74dp;height:91dp;"/><div id="control-hit-y" class="control-hit" style="left:-189dp;top:-89dp;"/></button>
<button id="control-b" class="control-callout" style="left:744dp;top:248dp;"><div id="control-label-b" class="control-label">B</div><div class="control-assignment"><span id="control-binding-b">x</span></div><div class="control-leader horizontal" style="left:-128dp;top:17dp;width:127dp;"/><div class="control-leader vertical" style="left:-128dp;top:-41dp;height:58dp;"/><div id="control-hit-b" class="control-hit" style="left:-143dp;top:-56dp;"/></button>
<button id="control-a" class="control-callout" style="left:744dp;top:188dp;"><div id="control-label-a" class="control-label">C</div><div class="control-assignment"><span id="control-binding-a">c</span></div><div class="control-leader horizontal" style="left:-79dp;top:17dp;width:78dp;"/><div class="control-leader vertical" style="left:-79dp;top:1dp;height:16dp;"/><div id="control-hit-a" class="control-hit" style="left:-94dp;top:-14dp;"/></button>
<button id="control-start" class="control-callout" style="left:16dp;top:308dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:265dp;"/><div class="control-leader vertical" style="left:454dp;top:-134dp;height:151dp;"/><div id="control-hit-start" class="control-hit" style="left:439dp;top:-149dp;"/></button>
<button id="control-l" class="control-callout" style="left:744dp;top:128dp;"><div id="control-label-l" class="control-label">X</div><div class="control-assignment"><span id="control-binding-l">a</span></div><div class="control-leader horizontal" style="left:-192dp;top:17dp;width:191dp;"/><div class="control-leader vertical" style="left:-192dp;top:17dp;height:30dp;"/><div id="control-hit-l" class="control-hit" style="left:-207dp;top:32dp;"/></button>
<button id="control-x" class="control-callout" style="left:744dp;top:68dp;"><div id="control-label-x" class="control-label">Y</div><div class="control-assignment"><span id="control-binding-x">s</span></div><div class="control-leader horizontal" style="left:-150dp;top:17dp;width:149dp;"/><div class="control-leader vertical" style="left:-150dp;top:17dp;height:68dp;"/><div id="control-hit-x" class="control-hit" style="left:-165dp;top:70dp;"/></button>
<button id="control-r" class="control-callout" style="left:744dp;top:8dp;"><div id="control-label-r" class="control-label">Z</div><div class="control-assignment"><span id="control-binding-r">d</span></div><div class="control-leader horizontal" style="left:-106dp;top:17dp;width:105dp;"/><div class="control-leader vertical" style="left:-106dp;top:17dp;height:116dp;"/><div id="control-hit-r" class="control-hit" style="left:-121dp;top:118dp;"/></button>
<button id="control-select" class="control-callout" style="left:16dp;top:8dp;"><div id="control-label-select" class="control-label">Mode</div><div class="control-assignment"><span id="control-binding-select">rshift</span></div><div class="control-leader horizontal" style="left:189dp;top:17dp;width:265dp;"/><div class="control-leader vertical" style="left:454dp;top:17dp;height:82dp;"/><div id="control-hit-select" class="control-hit" style="left:439dp;top:84dp;"/></button>