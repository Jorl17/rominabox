<rml><head><title>ROM-in-a-Box</title><link type="text/rcss" href="parts/background.rcss"/><link type="text/rcss" href="parts/navigation.rcss"/><link type="text/rcss" href="parts/slider.rcss"/><link type="text/rcss" href="parts/toggle.rcss"/><link type="text/rcss" href="menu.rcss"/></head><body id="body">
<div id="screen"><div id="spine"></div><div id="splash"><img id="splash-logo" src="splash-logo.png"/></div><div id="notice" class="notice">PRESS ESC TO PAUSE</div><div id="heading">MEMORY CARD</div><div id="pause-panel"><div id="slots"><button id="slot-1" class="slot empty selected"><div id="slot-label-1" class="slot-label">SLOT 1</div><div class="slot-picture"><div id="slot-image-1" class="slot-image"/></div><div id="slot-state-1" class="slot-state">EMPTY</div></button>
<button id="slot-2" class="slot empty "><div id="slot-label-2" class="slot-label">SLOT 2</div><div class="slot-picture"><div id="slot-image-2" class="slot-image"/></div><div id="slot-state-2" class="slot-state">EMPTY</div></button>
<button id="slot-3" class="slot empty "><div id="slot-label-3" class="slot-label">SLOT 3</div><div class="slot-picture"><div id="slot-image-3" class="slot-image"/></div><div id="slot-state-3" class="slot-state">EMPTY</div></button>
<button id="slot-4" class="slot empty "><div id="slot-label-4" class="slot-label">SLOT 4</div><div class="slot-picture"><div id="slot-image-4" class="slot-image"/></div><div id="slot-state-4" class="slot-state">EMPTY</div></button>
<button id="slot-5" class="slot empty "><div id="slot-label-5" class="slot-label">SLOT 5</div><div class="slot-picture"><div id="slot-image-5" class="slot-image"/></div><div id="slot-state-5" class="slot-state">EMPTY</div></button>
<button id="slot-6" class="slot empty "><div id="slot-label-6" class="slot-label">SLOT 6</div><div class="slot-picture"><div id="slot-image-6" class="slot-image"/></div><div id="slot-state-6" class="slot-state">EMPTY</div></button></div>
<div id="actions" class="no-options"><button class="menu-action" id="resume">CONTINUE</button><button class="menu-action" id="save">SAVE (SLOT <span data-fact="chosen-slot">1</span>)</button><button id="load" class="menu-action disabled" disabled="disabled">LOAD (SLOT <span data-fact="chosen-slot">1</span>)</button><button class="menu-action" id="disc">DISC</button><button class="menu-action" id="quit">QUIT</button></div>
<div id="status">CHOOSE A BLOCK</div></div><div id="controls-panel" class="screen-panel" style="display:none;">
<div id="controls-device" class="control-picker">
<div id="controls-device-label" class="control-picker-label">CONTROLLER</div>
<button id="controls-device-current" class="control-picker-current">MEGA DRIVE · 3 BUTTONS</button>
<div id="controls-device-list" class="control-picker-list" style="display:none;">
<button id="controls-device-option-megadrive" class="control-picker-option selected">MEGA DRIVE · 3 BUTTONS</button>
<button id="controls-device-option-megadrive6" class="control-picker-option">MEGA DRIVE · 6 BUTTONS</button>
</div>
</div>
<div id="controller-scene"><img id="controller-image" src="controller-megadrive.png"/>
<div class="control-leader horizontal" style="left:206dp;top:34dp;width:127dp;"/>
<div class="control-leader vertical" style="left:333dp;top:34dp;height:126dp;"/>
<button id="control-up" class="control-callout" style="left:16dp;top:16dp;"><div id="control-label-up" class="control-label">Up</div><div class="control-assignment"><span id="control-binding-up">up</span></div><div id="control-hit-up" class="control-hit" style="left:301dp;top:128dp;pointer-events:none;"/><div id="control-reach-up" class="control-reach" style="position:absolute;left:306dp;top:133dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:118dp;width:106dp;"/>
<div class="control-leader vertical" style="left:312dp;top:118dp;height:63dp;"/>
<button id="control-left" class="control-callout" style="left:16dp;top:100dp;"><div id="control-label-left" class="control-label">Left</div><div class="control-assignment"><span id="control-binding-left">left</span></div><div id="control-hit-left" class="control-hit" style="left:280dp;top:65dp;pointer-events:none;"/><div id="control-reach-left" class="control-reach" style="position:absolute;left:285dp;top:70dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:286dp;width:148dp;"/>
<div class="control-leader vertical" style="left:354dp;top:181dp;height:105dp;"/>
<button id="control-right" class="control-callout" style="left:16dp;top:268dp;"><div id="control-label-right" class="control-label">Right</div><div class="control-assignment"><span id="control-binding-right">right</span></div><div id="control-hit-right" class="control-hit" style="left:322dp;top:-103dp;pointer-events:none;"/><div id="control-reach-right" class="control-reach" style="position:absolute;left:327dp;top:-98dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:206dp;top:202dp;width:127dp;"/>
<div class="control-leader vertical" style="left:333dp;top:202dp;height:1dp;"/>
<button id="control-down" class="control-callout" style="left:16dp;top:184dp;"><div id="control-label-down" class="control-label">Down</div><div class="control-assignment"><span id="control-binding-down">down</span></div><div id="control-hit-down" class="control-hit" style="left:301dp;top:3dp;pointer-events:none;"/><div id="control-reach-down" class="control-reach" style="position:absolute;left:306dp;top:8dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:569dp;top:286dp;width:175dp;"/>
<div class="control-leader vertical" style="left:569dp;top:213dp;height:73dp;"/>
<button id="control-y" class="control-callout" style="left:744dp;top:268dp;"><div id="control-label-y" class="control-label">A</div><div class="control-assignment"><span id="control-binding-y">z</span></div><div id="control-hit-y" class="control-hit" style="left:-191dp;top:-71dp;pointer-events:none;"/><div id="control-reach-y" class="control-reach" style="position:absolute;left:-186dp;top:-66dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:623dp;top:202dp;width:121dp;"/>
<div class="control-leader vertical" style="left:623dp;top:186dp;height:16dp;"/>
<button id="control-b" class="control-callout" style="left:744dp;top:184dp;"><div id="control-label-b" class="control-label">B</div><div class="control-assignment"><span id="control-binding-b">x</span></div><div id="control-hit-b" class="control-hit" style="left:-137dp;top:-14dp;pointer-events:none;"/><div id="control-reach-b" class="control-reach" style="position:absolute;left:-132dp;top:-9dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:678dp;top:118dp;width:66dp;"/>
<div class="control-leader vertical" style="left:678dp;top:118dp;height:46dp;"/>
<button id="control-a" class="control-callout" style="left:744dp;top:100dp;"><div id="control-label-a" class="control-label">C</div><div class="control-assignment"><span id="control-binding-a">c</span></div><div id="control-hit-a" class="control-hit" style="left:-82dp;top:48dp;pointer-events:none;"/><div id="control-reach-a" class="control-reach" style="position:absolute;left:-77dp;top:53dp;width:20dp;height:20dp;"/></button>
<div class="control-leader horizontal" style="left:587dp;top:34dp;width:157dp;"/>
<div class="control-leader vertical" style="left:587dp;top:34dp;height:77dp;"/>
<button id="control-start" class="control-callout" style="left:744dp;top:16dp;"><div id="control-label-start" class="control-label">Start</div><div class="control-assignment"><span id="control-binding-start">enter</span></div><div id="control-hit-start" class="control-hit" style="left:-173dp;top:79dp;pointer-events:none;"/><div id="control-reach-start" class="control-reach" style="position:absolute;left:-168dp;top:84dp;width:20dp;height:20dp;"/></button></div><div id="control-binds" class="list" style="display:none;"><div id="binds-page-1" class="list-page"><button id="bind-1" class="list-row "><div id="bind-1-title" class="list-row-title"></div><div id="bind-1-detail" class="list-row-detail"></div><div id="bind-1-state" class="list-row-state"></div></button>
<button id="bind-2" class="list-row "><div id="bind-2-title" class="list-row-title"></div><div id="bind-2-detail" class="list-row-detail"></div><div id="bind-2-state" class="list-row-state"></div></button>
<button id="bind-3" class="list-row "><div id="bind-3-title" class="list-row-title"></div><div id="bind-3-detail" class="list-row-detail"></div><div id="bind-3-state" class="list-row-state"></div></button>
<button id="bind-4" class="list-row "><div id="bind-4-title" class="list-row-title"></div><div id="bind-4-detail" class="list-row-detail"></div><div id="bind-4-state" class="list-row-state"></div></button>
<button id="bind-5" class="list-row "><div id="bind-5-title" class="list-row-title"></div><div id="bind-5-detail" class="list-row-detail"></div><div id="bind-5-state" class="list-row-state"></div></button>
</div><div id="binds-page-2" class="list-page" style="display:none;"><button id="bind-6" class="list-row "><div id="bind-6-title" class="list-row-title"></div><div id="bind-6-detail" class="list-row-detail"></div><div id="bind-6-state" class="list-row-state"></div></button>
</div><div id="binds-pager" class="list-pager"><button id="binds-prev" class="menu-action list-pager-prev disabled">&lt;</button><div id="binds-page-count" class="list-pager-count">1/2</div><button id="binds-next" class="menu-action list-pager-next">&gt;</button></div></div><div id="controls-actions"><button class="menu-action" id="controls-back">BACK</button><button class="menu-action" id="controls-reset">RESET DEFAULTS</button><button class="menu-action" id="controls-cancel" style="display:none;">CANCEL</button></div><div id="controls-status">SELECT A BUTTON</div></div><div id="disc-panel" class="screen-panel" style="display:none;"><div id="disc-face"><div id="disc-hole"></div></div><button class="menu-action" id="disc-back">BACK</button></div><div id="unlock-row" style="display:none;"><div id="unlock"><img id="unlock-badge"/><div id="unlock-words"><div id="unlock-kicker">ACHIEVEMENT UNLOCKED</div><div id="unlock-title"></div><div id="unlock-detail"></div></div></div></div><div id="footer"><span id="footer-hint">ESC  CONTINUE</span></div></div></body></rml>
