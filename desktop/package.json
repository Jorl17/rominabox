{
  "name": "rominabox-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run catalog && npm run scene && vite",
    "build": "npm run catalog && npm run scene && tsc --noEmit && vite build",
    "check": "npm run scene && node ../scripts/python.mjs ../scripts/frontend_check.py",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "catalog": "cargo run --quiet --manifest-path crates/rominabox-catalog/Cargo.toml --bin rominabox-catalog -- generate",
    "catalog:validate": "cargo run --quiet --manifest-path crates/rominabox-catalog/Cargo.toml --bin rominabox-catalog -- validate",
    "scene": "node ../scripts/python.mjs ../scripts/render_controllers.py --stage-frontend"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
