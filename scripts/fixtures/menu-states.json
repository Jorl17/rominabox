{
  "comment": [
    "Every visual state of the in-game menu, declared once.",
    "",
    "A state is a set of element overrides, applied through RmlUi's own API by",
    "the offscreen renderer — the same SetProperty, SetClass and SetPseudoClass",
    "calls the bridge and RmlUi itself make at runtime. It is never an edit to",
    "the markup: matching markup strings would mean this file and the generator",
    "both had to change whenever an element did, which is the duplication",
    "console packages exist to avoid.",
    "",
    "'pseudo' sets a real pseudo-class, so a hover state renders the design's",
    "own :hover rule rather than a second rule written for the screenshot.",
    "",
    "A state names elements by id, or by position — 'controls-device-list>1' is the second option in the picker, whatever that console calls it, so one declaration renders on every console. scripts/menu_states.py refuses",
    "a state whose elements are not in the document, and refuses two states that",
    "render the same picture — declaring a state the design does not actually",
    "draw differently is how three of these were the same image.",
    "",
    "Adding a screen means adding entries here. Nothing else changes."
  ],
  "states": {
    "pause-menu": {
      "describes": "the menu as it opens, before anything is chosen",
      "set": {
        "pause-panel": {
          "display": "block"
        },
        "options-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "none"
        }
      }
    },
    "options": {
      "describes": "the options screen, listing what this game bundled",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "options-panel": {
          "display": "block"
        },
        "controls-panel": {
          "display": "none"
        },
        "heading": {
          "text": "OPTIONS"
        },
        "footer-hint": {
          "text": "ESC  BACK"
        }
      }
    },
    "controls": {
      "describes": "the controls screen, with the pad and its callouts",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        }
      }
    },
    "picker-hovered": {
      "describes": "the pointer on the closed picker, before it opens",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "none"
        },
        "controls-device-current": {
          "pseudo": "hover"
        }
      }
    },
    "picker-pressed": {
      "describes": "the closed picker held down, before the list appears",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "none"
        },
        "controls-device-current": {
          "pseudo": "active"
        }
      }
    },
    "picker-open": {
      "describes": "the picker open, listing what the author included",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "block"
        }
      }
    },
    "picker-hover-selected": {
      "describes": "the pointer on the option already in use",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "block"
        },
        "controls-device-list>0": {
          "pseudo": "hover"
        }
      }
    },
    "picker-hover-unselected": {
      "describes": "the pointer on an option that is not in use",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "block"
        },
        "controls-device-list>1": {
          "pseudo": "hover"
        }
      }
    },
    "picker-keyboard": {
      "describes": "an option reached by the arrow keys rather than the pointer",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "block"
        },
        "controls-device-list>1": {
          "class": "focused"
        }
      }
    },
    "picker-option-pressed": {
      "describes": "an option held down, before the button is released",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "block"
        },
        "controls-device-list>1": {
          "pseudo": "active"
        }
      }
    },
    "picker-dragged-outside": {
      "describes": "held down, pointer dragged off the list; releasing must not choose",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-device-list": {
          "display": "block"
        },
        "controls-device-list>1": {
          "pseudo": "active"
        },
        "control-hit-up": {
          "pseudo": "hover"
        }
      }
    },
    "control-focused": {
      "describes": "a control selected for rebinding, ring and callout lit",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "control-up": {
          "class": "focused"
        },
        "control-hit-up": {
          "class": "focused"
        }
      }
    },
    "capturing": {
      "describes": "a button being captured, when CANCEL joins the action row",
      "set": {
        "pause-panel": {
          "display": "none"
        },
        "controls-panel": {
          "display": "block"
        },
        "controls-cancel": {
          "display": "block"
        },
        "controls-status": {
          "text": "PRESS A KEY"
        },
        "control-up": {
          "class": "focused"
        },
        "control-hit-up": {
          "class": "focused"
        }
      }
    },
    "binds-closed": {
      "describes": "the pointer is on a control and the list has not opened yet",
      "set": {
        "pause-panel": { "display": "none" },
        "controls-panel": { "display": "block" },
        "control-up": { "pseudo": "hover" },
        "control-binds": { "display": "none" }
      }
    },
    "binds-pointer": {
      "describes": "the list open because the pointer is on the control",
      "set": {
        "pause-panel": { "display": "none" },
        "controls-panel": { "display": "block" },
        "control-up": { "pseudo": "hover" },
        "control-binds": { "display": "block", "left": "220dp", "top": "96dp", "width": "320dp" },
        "bind-1-title": { "text": "Up" },
        "bind-1-detail": { "text": "Up" },
        "bind-1-state": { "text": "KEY" },
        "bind-2-title": { "text": "Up" },
        "bind-2-detail": { "text": "Button 1" },
        "bind-2-state": { "text": "PAD" },
        "bind-3": { "display": "none" },
        "bind-4": { "display": "none" },
        "binds-pager": { "display": "none" }
      }
    },
    "binds-keyboard": {
      "describes": "the same list, opened because the control was reached with the arrow keys",
      "set": {
        "pause-panel": { "display": "none" },
        "controls-panel": { "display": "block" },
        "control-up": { "class": "focused" },
        "control-hit-up": { "class": "focused" },
        "control-binds": { "display": "block", "left": "220dp", "top": "96dp", "width": "320dp" },
        "bind-1-title": { "text": "Up" },
        "bind-1-detail": { "text": "Up" },
        "bind-1-state": { "text": "KEY" },
        "bind-2-title": { "text": "Up" },
        "bind-2-detail": { "text": "Button 1" },
        "bind-2-state": { "text": "PAD" },
        "bind-3": { "display": "none" },
        "bind-4": { "display": "none" },
        "binds-pager": { "display": "none" }
      }
    },
    "binds-line-hover": {
      "describes": "the pointer on one line of the open list",
      "set": {
        "pause-panel": { "display": "none" },
        "controls-panel": { "display": "block" },
        "control-up": { "pseudo": "hover" },
        "control-binds": { "display": "block", "left": "220dp", "top": "96dp", "width": "320dp" },
        "bind-1": { "pseudo": "hover" },
        "bind-1-title": { "text": "Up" },
        "bind-1-detail": { "text": "Up" },
        "bind-1-state": { "text": "KEY" },
        "bind-2-title": { "text": "Up" },
        "bind-2-detail": { "text": "Button 1" },
        "bind-2-state": { "text": "PAD" },
        "bind-3": { "display": "none" },
        "bind-4": { "display": "none" },
        "binds-pager": { "display": "none" }
      }
    },
    "binds-line-pressed": {
      "describes": "a line held down, before it is released",
      "set": {
        "pause-panel": { "display": "none" },
        "controls-panel": { "display": "block" },
        "control-up": { "pseudo": "hover" },
        "control-binds": { "display": "block", "left": "220dp", "top": "96dp", "width": "320dp" },
        "bind-1": { "pseudo": "active" },
        "bind-1-title": { "text": "Up" },
        "bind-1-detail": { "text": "Up" },
        "bind-1-state": { "text": "KEY" },
        "bind-2-title": { "text": "Up" },
        "bind-2-detail": { "text": "Button 1" },
        "bind-2-state": { "text": "PAD" },
        "bind-3": { "display": "none" },
        "bind-4": { "display": "none" },
        "binds-pager": { "display": "none" }
      }
    },
    "binds-line-dragged": {
      "describes": "a line held down and the pointer dragged off it before release",
      "set": {
        "pause-panel": { "display": "none" },
        "controls-panel": { "display": "block" },
        "control-binds": { "display": "block", "left": "220dp", "top": "96dp", "width": "320dp" },
        "bind-1": { "pseudo": "active" },
        "bind-1-title": { "text": "Up" },
        "bind-1-detail": { "text": "Up" },
        "bind-1-state": { "text": "KEY" },
        "bind-2-title": { "text": "Up" },
        "bind-2-detail": { "text": "Button 1" },
        "bind-2-state": { "text": "PAD" },
        "bind-3": { "display": "none" },
        "bind-4": { "display": "none" },
        "binds-pager": { "display": "none" },
        "control-a": { "pseudo": "hover" }
      }
    },
    "binds-overflow": {
      "describes": "more bindings than fit on one page, so the rest are on the next",
      "set": {
        "pause-panel": { "display": "none" },
        "controls-panel": { "display": "block" },
        "control-up": { "pseudo": "hover" },
        "control-binds": { "display": "block", "left": "220dp", "top": "96dp", "width": "320dp" },
        "bind-1-title": { "text": "Left stick" },
        "bind-1-detail": { "text": "Up" },
        "bind-1-state": { "text": "KEY" },
        "bind-2-title": { "text": "Left stick" },
        "bind-2-detail": { "text": "Down" },
        "bind-2-state": { "text": "KEY" },
        "bind-3-title": { "text": "Left stick" },
        "bind-3-detail": { "text": "Left" },
        "bind-3-state": { "text": "KEY" },
        "bind-4-title": { "text": "Left stick" },
        "bind-4-detail": { "text": "Right" },
        "bind-4-state": { "text": "KEY" }
      }
    }
  }
}
