      "disc": ["key:down", "key:down", "key:down", "report:pause-entry", "key:ok",
               "key:up", "key:up", "key:up", "report:options-entry", "key:ok"]
    }
  },
  "headless": {
    "reports": {
      "text.control-binds": "RetroArch describes each bind from its own bind table; the fake host describes every bind as a button and a key, so only whether the list is shown is compared",
      "bindsBox": "the list is sized by those descriptions, so only whether it has a box is compared"
    },
    "files": {
      "remaps/": "the remap is shipped by the exporter and rewritten by RetroArch when a pad is applied, not by the menu",
      "controls.cfg": {
        "lines": "input_player1_",
        "why": "RetroArch writes the bind lines from its own bind table; the menu writes the profile and the labels"
      }
    }
  },
