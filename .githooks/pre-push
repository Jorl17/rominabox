#!/bin/sh
# Run the whole suite before a push.
#
# The whole suite requires the prepared runtime kit, rsvg-convert and the
# built offscreen renderer.
#
#   git push --no-verify   skips it.
set -e
root=$(git rev-parse --show-toplevel)
. "$root/.githooks/python.sh"
exec "$python" "$root/scripts/test.py" --all
